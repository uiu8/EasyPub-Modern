<Window x:Class="EasyPub.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · EasyPub Modern v1.1.4" Width="1500" Height="860" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SettingsTab" TargetType="TabItem">
            <Setter Property="Width" Value="270"/><Setter Property="Height" Value="68"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Padding" Value="16,0"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" CornerRadius="9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SubtleSurfaceBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18"/></Style>
        <Style x:Key="SettingRow" TargetType="Border"><Setter Property="Padding" Value="16,13"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
        <Style x:Key="SettingsGlyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="21"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Height" Value="42"/><Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="12,8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="30,16"><Grid.ColumnDefinitions><ColumnDefinition Width="440"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><Border Width="58" Height="58" CornerRadius="13" Background="{DynamicResource PrimaryActionBrush}"><Image Source="/Assets/EasyPubModern.png" Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="16,2,0,0"><TextBlock Text="EasyPub Modern" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="TXT / EPUB 到 Kindle · 章节树、封面、正文插图与定制排版" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></StackPanel>
                <Border Grid.Column="1" Width="420" HorizontalAlignment="Center" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="15,0"><DockPanel><TextBlock Style="{StaticResource SettingsGlyph}" Text="&#xE721;" FontSize="19" Margin="0,0,10,0"/><TextBlock Text="搜索设置" Foreground="{DynamicResource DisabledTextBrush}" VerticalAlignment="Center"/><TextBlock Text="Ctrl+F" DockPanel.Dock="Right" Foreground="{DynamicResource DisabledTextBrush}" VerticalAlignment="Center"/></DockPanel></Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="15,10"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource SettingsGlyph}" Text="&#xE706;" FontSize="16"/><TextBlock Text="浅色" Margin="7,0,18,0"/><TextBlock Style="{StaticResource SettingsGlyph}" Text="&#xE708;" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="深色" Margin="7,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></Border><Border Margin="14,0,0,0" Background="{DynamicResource SelectedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18,10"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource SettingsGlyph}" Text="&#xE713;" FontSize="16"/><TextBlock Text="设置" Margin="8,0,0,0" FontWeight="SemiBold"/></StackPanel></Border></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><DockPanel Margin="30,14"><Button DockPanel.Dock="Right" Click="Cancel_Click" Padding="18,9"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource SettingsGlyph}" Text="&#xE72B;" FontSize="16"/><TextBlock Text="返回工作区" Margin="8,0,0,0"/></StackPanel></Button><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource SettingsGlyph}" Text="&#xE713;" FontSize="28" Margin="0,2,18,0"/><StackPanel><TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="管理应用级偏好；不会改变当前书稿的内容与排版" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></StackPanel></DockPanel></Border>

        <Border Grid.Row="2" Margin="18,14,18,10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
            <TabControl x:Name="SettingsTabs" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SettingsTab}" Padding="12">
                <TabItem>
                    <TabItem.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource SettingsGlyph}" Text="&#xE790;"/><StackPanel Grid.Column="1"><TextBlock Text="外观与显示" FontWeight="SemiBold"/><TextBlock Text="主题、缩放与界面密度" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></Grid></TabItem.Header>
                    <Grid Margin="22,4,4,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="外观与显示" FontSize="22" FontWeight="SemiBold"/>
                        <Grid Grid.Row="2">
                            <Border Style="{StaticResource SettingsCard}" Padding="0"><StackPanel>
                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="主题" FontWeight="SemiBold"/><TextBlock Text="应用程序的整体外观主题" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Grid Grid.Column="1"><ComboBox x:Name="ThemeCombo" Visibility="Collapsed"><ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="浅色" Tag="Light"/><ComboBoxItem Content="深色" Tag="Dark"/></ComboBox><UniformGrid Columns="3"><RadioButton x:Name="SystemThemeRadio" GroupName="Theme" Content="跟随系统" Tag="System" Style="{StaticResource SegmentRadio}" Click="ThemeRadio_Click"/><RadioButton x:Name="LightThemeRadio" GroupName="Theme" Content="浅色" Tag="Light" Style="{StaticResource SegmentRadio}" Click="ThemeRadio_Click"/><RadioButton x:Name="DarkThemeRadio" GroupName="Theme" Content="深色" Tag="Dark" Style="{StaticResource SegmentRadio}" Click="ThemeRadio_Click"/></UniformGrid></Grid></Grid></Border>
                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="界面密度" FontWeight="SemiBold"/><TextBlock Text="调整界面元素的紧凑程度" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><ComboBox x:Name="DensityCombo" Grid.Column="1"><ComboBoxItem Content="舒适" Tag="Comfortable"/><ComboBoxItem Content="紧凑" Tag="Compact"/></ComboBox></Grid></Border>
                                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="UI 缩放" FontWeight="SemiBold"/><TextBlock Text="调整界面整体缩放比例（重启生效）" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><ComboBox x:Name="ScaleCombo" Grid.Column="1"><ComboBoxItem Content="90%" Tag="90"/><ComboBoxItem Content="100%" Tag="100"/><ComboBoxItem Content="110%" Tag="110"/><ComboBoxItem Content="125%" Tag="125"/></ComboBox></Grid></Border>
                                <Border Style="{StaticResource SettingRow}"><Grid><StackPanel><TextBlock Text="记住窗口大小与位置" FontWeight="SemiBold"/><TextBlock Text="下次启动时恢复窗口状态" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><CheckBox x:Name="RememberWindowCheck" HorizontalAlignment="Right" IsChecked="True"/></Grid></Border>
                                <Border Padding="16,13"><Grid><StackPanel><TextBlock Text="减少动画" FontWeight="SemiBold"/><TextBlock Text="禁用非必要的动态效果" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><CheckBox x:Name="ReduceMotionCheck" HorizontalAlignment="Right"/></Grid></Border>
                            </StackPanel></Border>
                            </Grid>
                    </Grid>
                </TabItem>

                <TabItem><TabItem.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="□" FontSize="23"/><StackPanel Grid.Column="1"><TextBlock Text="默认目录" FontWeight="SemiBold"/><TextBlock Text="输出、报告与收藏文件夹" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></Grid></TabItem.Header><StackPanel Margin="22,4"><TextBlock Text="默认目录" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/><Border Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="默认输出目录" FontWeight="SemiBold"/><DockPanel Margin="0,9,0,0"><Button Content="浏览" DockPanel.Dock="Right" Click="BrowseOutput_Click" Margin="8,0,0,0"/><TextBox x:Name="DefaultOutputText"/></DockPanel></StackPanel></Border><Border Style="{StaticResource SettingsCard}" Margin="0,14,0,0"><DockPanel><StackPanel><TextBlock Text="验收报告" FontWeight="SemiBold"/><TextBlock Text="报告保存在独立的 EasyPub-验收报告 文件夹，默认只保留最近记录。" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="查看最近报告" Click="ViewLatestReport_Click"/><Button Content="打开报告目录" Click="OpenReports_Click" Margin="8,0,0,0"/></StackPanel></DockPanel></Border><Border Style="{StaticResource SettingsCard}" Margin="0,14,0,0"><StackPanel><TextBlock Text="收藏文件夹" FontWeight="SemiBold"/><TextBlock x:Name="FavoriteCountText" Margin="0,6,0,10" Foreground="{DynamicResource SecondaryTextBrush}"/><Button Content="管理收藏文件夹" HorizontalAlignment="Left" Click="ManageFavorites_Click"/></StackPanel></Border></StackPanel></TabItem>

                <TabItem><TabItem.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="23"/><StackPanel Grid.Column="1"><TextBlock Text="转换引擎" FontWeight="SemiBold"/><TextBlock Text="KindleGen 路径与自检" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></Grid></TabItem.Header><StackPanel Margin="22,4"><TextBlock Text="转换引擎" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/><Border Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="KindleGen 路径" FontWeight="SemiBold"/><DockPanel Margin="0,9,0,0"><Button Content="更换" DockPanel.Dock="Right" Click="BrowseKindleGen_Click" Margin="8,0,0,0"/><TextBox x:Name="KindleGenPathText"/></DockPanel><DockPanel Margin="0,12,0,0"><Button Content="执行引擎自检" DockPanel.Dock="Right" Click="TestKindleGen_Click" Margin="8,0,0,0"/><TextBlock x:Name="EngineStatusText" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="尚未检查"/></DockPanel></StackPanel></Border><TextBlock Text="MOBI 输出使用兼容原版 EasyPub 的联合 MOBI7 + KF8 处理链。" Margin="4,14,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></TabItem>

                <TabItem><TabItem.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="◴" FontSize="23"/><StackPanel Grid.Column="1"><TextBlock Text="性能与验收" FontWeight="SemiBold"/><TextBlock Text="并发、结构检查与报告保留" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></Grid></TabItem.Header><StackPanel Margin="22,4"><TextBlock Text="性能与验收" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/><Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="默认并发任务" FontWeight="SemiBold"/><TextBlock Text="批量转换时同时处理的书稿数。" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel><ComboBox x:Name="ParallelismSettingsCombo" Grid.Column="1"><ComboBoxItem Content="自动（推荐）" Tag="0"/><ComboBoxItem Content="1" Tag="1"/><ComboBoxItem Content="2" Tag="2"/><ComboBoxItem Content="4" Tag="4"/><ComboBoxItem Content="8" Tag="8"/><ComboBoxItem Content="12" Tag="12"/><ComboBoxItem Content="16" Tag="16"/><ComboBoxItem Content="32" Tag="32"/></ComboBox></Grid></Border><Border Style="{StaticResource SettingsCard}" Margin="0,14,0,0"><StackPanel><CheckBox x:Name="ValidationSettingsCheck" Content="转换后执行结构验收（较慢）" Click="ValidationSettingsCheck_Click"/><DockPanel Margin="25,12,0,0"><TextBlock Text="最多保留报告" VerticalAlignment="Center"/><ComboBox x:Name="RetentionSettingsCombo" Width="220" Margin="16,0,0,0"><ComboBoxItem Content="5 条" Tag="5"/><ComboBoxItem Content="10 条（默认）" Tag="10"/><ComboBoxItem Content="20 条" Tag="20"/><ComboBoxItem Content="50 条" Tag="50"/></ComboBox></DockPanel></StackPanel></Border><CheckBox x:Name="AutoOpenTaskCenterSettingsCheck" Content="转换时自动打开任务中心" Margin="4,16,0,0"/><CheckBox x:Name="AutoOpenOutputSettingsCheck" Content="转换完成后自动打开输出目录" Margin="4,12,0,0"/><Button Content="管理快捷键" HorizontalAlignment="Left" Margin="0,16,0,0" Click="ManageShortcuts_Click"/></StackPanel></TabItem>

                <TabItem><TabItem.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="↶" FontSize="23"/><StackPanel Grid.Column="1"><TextBlock Text="数据与恢复" FontWeight="SemiBold"/><TextBlock Text="自动保存与项目快照" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></Grid></TabItem.Header><StackPanel Margin="22,4"><TextBlock Text="数据与恢复" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/><Border Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="项目快照" FontWeight="SemiBold"/><TextBlock Text="程序会在工作发生变化后自动保存恢复快照；正常保存或删除快照不会修改原 TXT。" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></Border><Button Content="打开应用数据目录" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OpenAppData_Click"/></StackPanel></TabItem>

                <TabItem><TabItem.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="ⓘ" FontSize="23"/><StackPanel Grid.Column="1"><TextBlock Text="更新与关于" FontWeight="SemiBold"/><TextBlock Text="版本、更新与开源信息" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></Grid></TabItem.Header><StackPanel Margin="22,4"><TextBlock Text="更新与关于" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/><Border Style="{StaticResource SettingsCard}"><StackPanel><Image Source="/Assets/EasyPubModern.png" Width="72" Height="72" HorizontalAlignment="Left"/><TextBlock Text="EasyPub Modern" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="版本 1.1.4 · TXT / EPUB 到 Kindle" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="现代批量工作流与原版 EasyPub 兼容转换能力。" Margin="0,12,0,0"/><Button Content="打开 GitHub 项目主页" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OpenGitHub_Click"/></StackPanel></Border></StackPanel></TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="3" Margin="18,0,18,14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11"><DockPanel Margin="18,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="恢复默认设置" IsEnabled="False" Margin="0,0,14,0"/><Button Content="保存并返回工作区" Click="Save_Click" Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}" BorderBrush="{DynamicResource PrimaryActionBrush}" Padding="24,9"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="22" Margin="0,0,10,0"/><TextBlock x:Name="SaveHintText" Text="设置将在保存后应用" VerticalAlignment="Center"/></StackPanel></DockPanel></Border>
    </Grid>
</Window>
