<Window x:Class="EasyPub.Desktop.CustomCssWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="定制 CSS" Width="780" Height="600" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" FontFamily="Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="导入 .css" Click="Import_Click" Padding="14,7" Margin="0,0,8,0"/>
                <Button Content="导出副本" Click="Export_Click" Padding="14,7" Margin="0,0,8,0"/>
                <Button Content="清空" Click="Clear_Click" Padding="14,7"/>
            </StackPanel>
            <StackPanel>
            <TextBlock Text="定制 CSS" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Margin="0,4,0,0" Text="会追加到原版 EasyPub 样式之后，可覆盖正文、标题、目录和插图样式。" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="2" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="1">
            <TextBox x:Name="CssEditor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas" FontSize="14" Padding="12" BorderThickness="0"
                     SpellCheck.IsEnabled="False"/>
        </Border>
        <DockPanel Grid.Row="4">
            <TextBlock x:Name="SourceText" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="取消" IsCancel="True" Padding="18,8" Margin="0,0,8,0"/>
            <Button Content="应用 CSS" IsDefault="True" Click="Apply_Click" Padding="20,8" Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}" BorderBrush="{DynamicResource PrimaryActionBrush}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
