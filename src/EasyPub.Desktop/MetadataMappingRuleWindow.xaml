<Window x:Class="EasyPub.Desktop.MetadataMappingRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑元数据映射 · EasyPub Modern v0.17.2" Width="760" Height="650" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F5F7FB" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="9,6"/><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D0D7E2"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="36"/><Setter Property="BorderBrush" Value="#D0D7E2"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D0D7E2"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#475467"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="编辑文件夹规则" FontSize="24" FontWeight="SemiBold" Foreground="#172033"/>
            <TextBlock Text="只填写需要自动写入的字段；未填写项继续使用主窗口的统一书籍信息。" Margin="0,4,0,0" Foreground="#667085"/>
        </StackPanel>
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.ColumnSpan="3"><TextBlock Style="{StaticResource Label}" Text="来源文件夹"/><DockPanel><Button Content="选择…" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseFolder_Click"/><TextBox x:Name="FolderPathText"/></DockPanel></StackPanel>
                <StackPanel Grid.Row="2"><TextBlock Style="{StaticResource Label}" Text="作者"/><TextBox x:Name="AuthorText"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="译者"/><TextBox x:Name="TranslatorText"/></StackPanel>
                <StackPanel Grid.Row="4"><TextBlock Style="{StaticResource Label}" Text="出版社"/><TextBox x:Name="PublisherText"/></StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="类别"/><ComboBox x:Name="CategoryCombo" IsEditable="True"><ComboBoxItem Content="小说"/><ComboBoxItem Content="文学"/><ComboBoxItem Content="科幻"/><ComboBoxItem Content="奇幻"/><ComboBoxItem Content="悬疑"/><ComboBoxItem Content="历史"/><ComboBoxItem Content="传记"/><ComboBoxItem Content="社科"/><ComboBoxItem Content="技术"/><ComboBoxItem Content="其他"/></ComboBox></StackPanel>
                <StackPanel Grid.Row="6"><TextBlock Style="{StaticResource Label}" Text="ISBN"/><TextBox x:Name="IsbnText"/></StackPanel>
                <Grid Grid.Row="6" Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Label}" Text="出版日期"/><DatePicker x:Name="PublicationDatePicker" MinHeight="36"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="语言"/><ComboBox x:Name="LanguageCombo" IsEditable="True"><ComboBoxItem Content="zh-CN"/><ComboBoxItem Content="zh-TW"/><ComboBoxItem Content="en"/><ComboBoxItem Content="ja"/><ComboBoxItem Content="ko"/></ComboBox></StackPanel></Grid>
                <StackPanel Grid.Row="8" Grid.ColumnSpan="3"><TextBlock Style="{StaticResource Label}" Text="简介"/><TextBox x:Name="DescriptionText" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/></StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Click="Cancel_Click"/>
            <Button Content="保存此规则" Click="Save_Click" Margin="0" Background="#2563EB" Foreground="White" BorderBrush="#2563EB"/>
        </StackPanel>
    </Grid>
</Window>
