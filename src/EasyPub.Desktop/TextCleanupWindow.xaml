<Window x:Class="EasyPub.Desktop.TextCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文本清理流水线 · EasyPub Modern" Width="1160" Height="820" MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" FontFamily="Microsoft YaHei UI">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="文本清理流水线" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock x:Name="BookPathText" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Visibility="Collapsed" x:Name="ScopeHintText" Margin="0,4,0,0" Text="仅预览，转换时处理，不修改原文件。" Foreground="{DynamicResource SuccessBrush}"/>

        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
            <StackPanel>
                <DockPanel><Expander x:Name="ScopeExpander" DockPanel.Dock="Right" Header="作用范围：本书" Margin="12,0,0,0"><StackPanel MaxWidth="360">
<StackPanel Margin="0,8,0,0"><CheckBox x:Name="SharedScopeCheck" VerticalAlignment="Center"><TextBlock Text="应用为项目通用规则，并保存为下次默认（已有逐书覆盖不受影响）" TextWrapping="Wrap" MaxWidth="300"/></CheckBox><Button Content="本书恢复继承通用规则" HorizontalAlignment="Left" Margin="0,8,0,0" Click="InheritShared_Click"/></StackPanel>
                </StackPanel></Expander><TextBlock x:Name="ActiveRulesText" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
                <Expander x:Name="RulesExpander" Header="调整规则" Margin="0,6,0,0"><ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto"><StackPanel>
            <WrapPanel>
                <CheckBox x:Name="BlankLinesCheck" Content="合并连续空行" Margin="0,0,22,8" Click="Option_Click"/>
                <CheckBox x:Name="HardWrapCheck" Content="修复正文硬换行" Margin="0,0,22,8" Click="Option_Click"/>
                <CheckBox x:Name="SpacesCheck" Content="统一全角空格" Margin="0,0,22,8" Click="Option_Click"/>
                <CheckBox x:Name="ChapterCheck" Content="标准化章节编号" Margin="0,0,22,8" Click="Option_Click"/>
                <CheckBox x:Name="NoticeCheck" Content="清理网站广告/下载说明" Margin="0,0,22,8" Click="Option_Click"/>
                <CheckBox x:Name="PunctuationCheck" Content="规范中文标点" Margin="0,0,22,8" Click="Option_Click"/>
                <CheckBox x:Name="InvisibleCheck" Content="删除零宽/控制字符" Margin="0,0,22,8" Click="Option_Click"/>
                <CheckBox x:Name="DuplicateChapterCheck" Content="删除重复章节标题" Margin="0,0,22,8" Click="Option_Click"/>
                <CheckBox x:Name="ParagraphBoundaryCheck" Content="修复段落粘连" Margin="0,0,22,8" Click="Option_Click"/>
                <CheckBox x:Name="RepeatedHeaderCheck" Content="删除重复页眉/页码" Margin="0,0,22,8" Click="Option_Click"/>
                <CheckBox x:Name="OcrCheck" Content="安全 OCR 空白修复" Margin="0,0,22,8" Click="Option_Click"/>
                <TextBlock Text="简繁转换" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox x:Name="ChineseVariantCombo" Width="140" SelectedIndex="0" SelectionChanged="ChineseVariantCombo_SelectionChanged" Margin="0,0,0,8">
                    <ComboBoxItem Content="不转换" Tag="None"/><ComboBoxItem Content="繁体转简体" Tag="ToSimplified"/><ComboBoxItem Content="简体转繁体" Tag="ToTraditional"/>
                </ComboBox>
                <Button x:Name="ManageCustomRulesButton" Content="编辑自定义规则与测试…" Margin="18,0,0,8" Padding="14,6" Click="ManageCustomRules_Click" ToolTip="编辑普通替换或正则规则；返回后会在下方显示真实修改并支持逐项排除"/>
                <Button Content="内置规则自定义 / 恢复默认…" Margin="12,0,0,8" Click="ManageBuiltins_Click"/>
            </WrapPanel>
                <WrapPanel><Button Content="关闭所有规则" Click="Clear_Click" Padding="10,5"/><TextBlock x:Name="CustomRuleSummaryText" Margin="12,0" VerticalAlignment="Center"/></WrapPanel>
                </StackPanel></ScrollViewer></Expander>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <ComboBox x:Name="ChangeRuleFilterCombo" Width="145" Margin="0,0,8,0" SelectionChanged="ChangeFilter_Changed" AutomationProperties.Name="按清理规则筛选"/>
                            <TextBox x:Name="ChangeSearchText" Width="170" Padding="8,5" TextChanged="ChangeFilter_Changed" ToolTip="搜索修改前、修改后或规则" AutomationProperties.Name="搜索清理修改"/>
                        </StackPanel>
                    <TextBlock x:Name="ChangeSummaryText" Text="尚未选择清理规则" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Grid.Row="2"><WrapPanel><CheckBox x:Name="GroupAdsCheck" Content="折叠完全重复项" Click="Grouping_Changed" ToolTip="适用于所有内置及自定义规则；只折叠同一规则下修改前后内容完全一致的记录"/><Button x:Name="ExpandAdGroupButton" Content="展开逐处核对" Click="ExpandGroup_Click" Visibility="Collapsed" Padding="7,3" Margin="10,0,0,0"/><Button x:Name="BackToGroupsButton" Content="返回全部记录" Click="BackToGroups_Click" Visibility="Collapsed" Padding="7,3" Margin="10,0,0,0"/></WrapPanel><TextBlock x:Name="GroupingSummaryText" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
                    <DataGrid x:Name="ChangesGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                              SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="ChangesGrid_SelectionChanged"
                              AutomationProperties.Name="文本清理修改记录，选择一项可定位正文">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="采用" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding ToggleLabel}" Tag="{Binding Key}" Click="ToggleChange_Click" Padding="7,3" Margin="2" AutomationProperties.Name="{Binding AccessibleToggleLabel}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="48"/>
                            <DataGridTemplateColumn Header="内容摘要 / 状态" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="6,5"><TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8"><Button x:Name="PreviousChangeButton" Content="← 上一处" Click="PreviousChange_Click" Padding="8,4"/><TextBlock x:Name="ChangePositionText" VerticalAlignment="Center" Margin="10,0"/><Button x:Name="NextChangeButton" Content="下一处 →" Click="NextChange_Click" Padding="8,4"/><RadioButton x:Name="OriginalPreviewRadio" GroupName="PreviewMode" Content="原文" IsChecked="True" Checked="PreviewMode_Changed" Margin="18,0,10,0" VerticalAlignment="Center"/><RadioButton x:Name="ProcessedPreviewRadio" GroupName="PreviewMode" Content="清理后" Checked="PreviewMode_Changed" VerticalAlignment="Center"/></WrapPanel>
                        <TextBlock x:Name="CurrentChangeSummary" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <WrapPanel x:Name="CurrentRuleActions" Margin="0,5,0,0"/>
                        <Button x:Name="AddAdvertisementRuleButton" Content="添加到广告规则…" Click="AddAdvertisementRule_Click" Visibility="Collapsed" HorizontalAlignment="Left" Padding="12,6" Margin="0,6" ToolTip="选择作为广告或始终保留，自动查看影响后保存"/>
                        <Expander x:Name="DetailsExpander" Header="修改详情" Margin="0,4"><ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock x:Name="ChangeDetailReason" TextWrapping="Wrap"/>
                            <TextBlock Text="修改前" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,2"/><TextBlock x:Name="ChangeDetailBefore" TextWrapping="Wrap"/>
                            <TextBlock Text="拟修改为（已保留的记录不会执行）" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,2"/><TextBlock x:Name="ChangeDetailAfter" TextWrapping="Wrap"/>
                        </StackPanel></ScrollViewer></Expander>
                        <TextBlock x:Name="PreviewLocationText" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBox x:Name="PreviewText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="Microsoft YaHei UI"
                             IsInactiveSelectionHighlightEnabled="True" AutomationProperties.Name="原文与清理后正文定位预览"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <WrapPanel x:Name="RecentActionPanel" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,0,0,8"><TextBlock x:Name="RecentActionText" VerticalAlignment="Center"/><Button x:Name="UndoConditionButton" Content="撤销" Click="UndoCondition_Click" Visibility="Collapsed" Padding="8,4" Margin="8,0"/><Button x:Name="RecentRuleButton" Content="继续编辑" Click="RecentRule_Click" Padding="8,4"/></WrapPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal"><Button Content="恢复打开时设置" Padding="14,8" Margin="0,0,8,0" Click="Undo_Click"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><Button Content="取消" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"/><Button x:Name="ApplyRulesButton" Content="应用规则" Padding="20,8" Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}" BorderBrush="{DynamicResource PrimaryActionBrush}" Click="Apply_Click"/></StackPanel>
        </Grid>
    </Grid>
</Window>
