<Window x:Class="EasyPub.Desktop.ChapterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="章节编辑与标题规范化 · EasyPub Modern v0.9.1"
        Width="1180" Height="760" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F4F5F7">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="章节编辑与标题规范化" FontSize="26" FontWeight="SemiBold" Foreground="#202124"/>
                <TextBlock x:Name="SourceText" Margin="0,5,0,0" Foreground="#5F6368" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#E8F0FE" CornerRadius="8" Padding="14,9" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText" Foreground="#174EA6" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#DADCE0" BorderThickness="1" CornerRadius="10" Padding="8">
                <DataGrid x:Name="CandidatesGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0" SelectionMode="Single"
                          SelectionChanged="CandidatesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="应用" Binding="{Binding IsApplied, UpdateSourceTrigger=PropertyChanged}" Width="58"/>
                        <DataGridTextColumn Header="行号" Binding="{Binding LineNumber}" IsReadOnly="True" Width="64"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding KindLabel}" IsReadOnly="True" Width="98"/>
                        <DataGridTextColumn Header="原标题" Binding="{Binding OriginalTitle}" IsReadOnly="True" Width="2*"/>
                        <DataGridTextColumn Header="编辑后标题" Binding="{Binding TargetTitle, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#DADCE0" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="原文上下文预览" FontSize="16" FontWeight="SemiBold" Foreground="#202124"/>
                    <TextBox x:Name="PreviewText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="14" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="#F8FAFD" Padding="12"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="全选全部章节" Click="SelectAll_Click" Background="#E6F4EA" Foreground="#137333"/>
                <Button Content="一键转换全部数字标题" Click="NormalizeAll_Click" Background="#E8F0FE" Foreground="#174EA6"/>
                <Button Content="取消全选" Click="ClearAll_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="关闭" Click="Close_Click"/>
                <Button Content="另存并用于转换" Click="SaveAs_Click" Margin="0" Padding="22,9"
                        FontWeight="SemiBold" Background="#1A73E8" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
