<Window x:Class="EasyPub.Desktop.ChapterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasyPub.Desktop"
        Title="章节工作台 · EasyPub Modern" Width="1480" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <!-- One-click repair is the action most users actually want, so it carries the primary colour
             and sits first instead of blending into a row of identical grey buttons. Colours are
             DynamicResource so a window built without App.xaml (tests) still loads. -->
        <Style x:Key="HeroRepairButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryActionTextBrush}"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <!-- 顶部工具栏按钮不能被“主行动 + 依据说明”这一列的高度撑大。 -->
        <Style x:Key="ChapterToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="ChapterModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ChapterModeCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ModeSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ModeSurface" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/><Setter TargetName="ModeSurface" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeSurface" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ModeSurface" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChapterFilterRadio" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="FilterSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FilterSurface" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
                                <Setter TargetName="FilterSurface" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterSurface" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FilterSurface" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FilterSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChapterModeRadio" TargetType="RadioButton" BasedOn="{StaticResource ChapterFilterRadio}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:ChapterTreeNode}" ItemsSource="{Binding VisibleChildren}">
            <!-- The break strip sits directly above the row it belongs to, so it reads as the space between
                 this chapter and the one before it rather than as part of either chapter. -->
            <StackPanel>
                <Border Background="{DynamicResource WarningSurfaceBrush}" BorderThickness="3,0,0,0" CornerRadius="3"
                        Padding="7,4" Margin="0,4,0,2" ToolTip="{Binding BreakDetail}">
                    <Border.Style><Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasBreak}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            <DataTrigger Binding="{Binding BreakAccent}" Value="Error"><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style></Border.Style>
                    <TextBlock Text="{Binding BreakLabel}" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningBrush}"/>
                </Border>
                <Border Padding="5,6" CornerRadius="5">
                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                        <DataTrigger Binding="{Binding IsOperationSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/></DataTrigger>
                    </Style.Triggers></Style></Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IncludeInToc}" ToolTip="加入阅读器目录；与批量操作选中无关，不删除正文" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding ReviewMarker}" ToolTip="{Binding ReviewDescription}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Border Grid.Column="2" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="7" Padding="5,1" Margin="0,0,7,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LevelLabel}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                        </Border>
                        <TextBlock Grid.Column="3" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" MouseLeftButtonDown="Title_MouseLeftButtonDown" ToolTip="{Binding Title}"/>
                        <TextBlock Grid.Column="4" Text="{Binding LineCountLabel}" ToolTip="正文源行数，不含独立标题；重复标题清理使用此行数"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="检查与修复  /  章节工作台" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock x:Name="BookTitleText" Text="章节工作台" FontSize="29" FontWeight="SemiBold" Margin="0,9,0,0"/>
                <TextBlock x:Name="SourceText" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SummaryText" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="检查依据" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="LocalRepairOnlyOption" Content="当前书稿" Style="{StaticResource ChapterModeCheck}"
                                      Checked="RepairBasis_Changed" Unchecked="RepairBasis_Changed"
                                      ToolTip="本次只按当前章节树判断，不读取参考目录、不联网。"/>
                            <Button x:Name="CatalogAssistButton" Style="{StaticResource ChapterModeButton}" Content="参考目录" Click="CatalogAssist_Click"
                                    ToolTip="选择、粘贴或获取参考目录；选定后才写入本书记录，不直接修改章节树。"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="应用范围" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <Border Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TreeOnlyOption" Content="仅整理章节树" GroupName="WorkbenchLandingMode"
                                         Style="{StaticResource ChapterModeRadio}" Checked="RepairLandingMode_Changed"
                                         ToolTip="只更新成品章节树与项目记录，原始 TXT 保持不变。"/>
                            <RadioButton x:Name="EditSourceOption" Content="同时修改 TXT" GroupName="WorkbenchLandingMode"
                                         Style="{StaticResource ChapterModeRadio}" Checked="RepairLandingMode_Changed"
                                         ToolTip="在预览确认后先备份，再把可验证的文本动作写入当前 TXT。"/>
                        </StackPanel>
                    </Border>
                    <!-- 选择本身已经说明范围；详细后果写入确认窗和页脚，避免顶部重复一遍。 -->
                    <TextBlock x:Name="ApplyScopeSummaryText" Text="仅整理章节树（TXT 不变）" Visibility="Collapsed" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button x:Name="RecoverStructureButton" Style="{StaticResource ChapterToolbarButton}" Visibility="Collapsed" Content="结构整理…" Click="RecoverStructure_Click" ToolTip="预览编号分组、排除假卷与额外章头，按原文顺序重建"/>
                </StackPanel>
                <!--
                  右侧是唯一的检查入口。外层 WrapPanel 保留旧的自动化测试与键盘导航层级，
                  内层 StackPanel 让主按钮与当前依据说明成为一个语义组；按钮本身只生成建议，
                  不直接应用任何修复。
                -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel>
                        <Button x:Name="AutoRepairButton" Style="{StaticResource HeroRepairButton}" Click="AutoRepair_Click" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="检查章节  →" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <!-- 保留旧的文案作为自动化可访问文本，不参与视觉布局。 -->
                                <TextBlock Text="检查并生成建议" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="AutoRepairButtonText" Text="检查并生成建议" Visibility="Collapsed"/>
                        <TextBlock x:Name="AutoRepairBasisText" Margin="3,4,0,0" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" HorizontalAlignment="Right"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
            <!-- 预览图中的一行事实状态：只保留用户下一步真正需要知道的三件事。 -->
            <Border x:Name="CompactStatusBar" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                    Padding="0,2" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactCatalogStatusDot" Text="●" Foreground="{DynamicResource WarningBrush}" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CompactCatalogStatusText" Text="目录未选择" FontSize="12.5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="│" Foreground="{DynamicResource BorderBrush}" Margin="14,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙  识别规则：本书配置" FontSize="12.5" VerticalAlignment="Center"/>
                        <Button x:Name="RecognitionSettingsButton" Content="查看" Style="{StaticResource ChapterModeButton}"
                                Click="RecognitionSettings_Click" Margin="3,0,0,0"
                                ToolTip="查看并调整本书实际生效的识别规则。"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="│" Foreground="{DynamicResource BorderBrush}" Margin="14,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactSourceStatusDot" Text="●" Foreground="{DynamicResource SuccessBrush}" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CompactSourceStatusText" Text="原文版本一致" FontSize="12.5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="WorkbenchMoreButton" Grid.Column="5" Content="专项处理 ▾" Style="{StaticResource ChapterModeButton}"
                            Click="WorkbenchMore_Click" Margin="14,0,0,0" ToolTip="打开移动、分割、标题和结构等专项处理。"/>
                </Grid>
            </Border>
            <!-- 旧的详细事实仍由代码维护，作为自动化和辅助信息的数据源；视觉上不再占据工作台。 -->
            <StackPanel x:Name="LegacyWorkbenchGuidance" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Visibility="Collapsed">
                <!--
                  三行事实。**它们不能互相推导，所以显示三行而不是一个模式标签：**
                  「有目录」与「树是按目录改的」是两件事（可以先按目录修完树再清掉目录记录，
                  也可以只获取目录却从不使用），而「原文是否被外部改过」又是第三件。
                  一个「修复依据」开关只能说出其中一件，于是总有一半是假的。
                -->
                <Border x:Name="ContextBar" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="7" Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="参考目录" FontSize="12.5" Margin="0,0,12,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="ContextCatalogText" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <!--
                              「忘记这份目录」**只删这条配置记录，不动章节树**（§3.3）。
                              它与「重新识别章节（会替换手工调整）…」是两件独立的事：树是按那次修复改过的，
                              记录没了不代表树变回本地识别的样子。所以忘掉之后，第一行会变成「未加载」
                              而第二行仍是「目录校验后」—— 两行同时成立，而且都是真的。
                            -->
                            <Button x:Name="ForgetCatalogButton" Content="忘记这份目录" Click="ForgetCatalog_Click"
                                    Margin="10,0,0,0" Padding="8,2" MinHeight="22" FontSize="11" Visibility="Collapsed"
                                    ToolTip="只删除本书记住的这份参考目录，以后不再自动使用；**当前章节树不受影响**。若还想让树回到本地规则，请用「重新识别章节」"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="当前章节树" FontSize="12.5" Margin="0,0,12,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ContextTreeText" FontSize="12.5" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="原文版本" FontSize="12.5" Margin="0,0,12,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ContextSourceText" FontSize="12.5" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <!--
                  「下一步」那一句。**它比上面三行事实更大、更靠前**：三行说的是"现在是什么状态"，
                  这一句说的是"你该做什么" —— 用户走进来要的是后者。

                  原来的这里是同一段 11 号灰字，和状态条挤在一起，而它其实只说了句泛泛的
                  "点主按钮生成建议"。现在它由 IssueResolutionPolicy.Summarize 算出来：
                  这本书有几处本地能修、几处非要目录不可、几处只能人工核对。
                -->
                <Border x:Name="NextStepBar" Margin="0,10,0,0" Padding="14,11" CornerRadius="8"
                        Background="{DynamicResource RaisedSurfaceBrush}">
                    <StackPanel>
                        <TextBlock x:Name="NextStepHeadline" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="NextStepDetail" Margin="0,5,0,0" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ActionGuideBar" Margin="0,8,0,0" Padding="10,8" CornerRadius="7"
                        Background="{DynamicResource SubtleSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="① 依据" FontWeight="SemiBold" FontSize="11.5"/>
                            <TextBlock x:Name="GuideBasisText" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="② 应用范围" FontWeight="SemiBold" FontSize="11.5"/>
                            <TextBlock x:Name="GuideApplyText" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="③ 可以撤回" FontWeight="SemiBold" FontSize="11.5"/>
                            <TextBlock x:Name="GuideUndoText" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock x:Name="WorkflowHintText" Visibility="Collapsed" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
            <Border x:Name="StructureSuggestionBanner" Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,10,0,0" Padding="10" Background="{DynamicResource RaisedSurfaceBrush}" CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="StructureSuggestionText" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="预览结构整理…" Click="RecoverStructure_Click"/>
                        <Button Content="查看依据 / 涉及位置" Click="StructureEvidence_Click"/>
                        <Button Content="本次暂不提醒" Click="DismissStructure_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <!-- 目录 / 待核对 / 证据与原文三栏工作台；业务事件和控件名称保持不变。 -->
            <Grid.ColumnDefinitions><ColumnDefinition Width="30*" MinWidth="285"/><ColumnDefinition Width="10"/><ColumnDefinition Width="23*" MinWidth="245"/><ColumnDefinition Width="10"/><ColumnDefinition Width="47*" MinWidth="420"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="2" HorizontalAlignment="Left"
                                ToolTip="选择目录显示范围；两项只能选择一项">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AllChaptersRadio" GroupName="ChapterFilterMode" Content="全部章节"
                                             Style="{StaticResource ChapterFilterRadio}" IsChecked="True" Click="AllChapters_Click"
                                             ToolTip="显示全部章节" AutomationProperties.Name="全部章节"/>
                                <RadioButton x:Name="ReviewOnlyCheck" GroupName="ChapterFilterMode" Content="待核对"
                                             Style="{StaticResource ChapterFilterRadio}" Click="ReviewFilter_Click"
                                             ToolTip="只显示有提醒或需要核对的章节" AutomationProperties.Name="待核对"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <WrapPanel Grid.Row="1">
                    <Button x:Name="FetchCatalogButton" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Content="获取参考目录（联网）" Click="FetchCatalog_Click"
                            ToolTip="按书源顺序搜索本书的公开目录并保存。只有拿到目录，才能标出「这里本该有哪一章」；失败时可改用手动核对并粘贴网址。"/>
                    <Button x:Name="NumberingNotesButton" Content="编号差异" Click="NumberingNotes_Click" Visibility="Collapsed" Margin="6,10,0,0"/>
                    </WrapPanel>
                    <Grid Grid.Row="2" Margin="0,10,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ChapterSearchText" ToolTip="搜索成品/原始标题；输入 行:51397 定位源行" AutomationProperties.Name="搜索章节标题或原文行号" TextChanged="ChapterSearch_Changed" KeyDown="ChapterSearch_KeyDown"/>
                        <Button Grid.Column="1" Content="清除" Click="ClearSearch_Click" Margin="6,0,0,0"/>
                    </Grid>
                    <TextBlock x:Name="FilterSummaryText" Grid.Row="3" Text="搜索章节标题，或输入 行:51397" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    <DockPanel Grid.Row="4" Margin="0,8,0,6">
                        <Button DockPanel.Dock="Right" Content="取消选择" Click="ClearSelection_Click" FontSize="11" Padding="7,3" MinHeight="26" Margin="4,0,0,0"/>
                        <TextBlock x:Name="BatchSelectionText" Text="Ctrl 多选 · Shift 连选" ToolTip="行高亮是操作选择，复选框仅控制目录" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TreeView x:Name="ChapterTree" Grid.Row="5" ItemsSource="{Binding VisibleRoots}" BorderThickness="0" Background="Transparent"
                              VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="ChapterTree_SelectedItemChanged" AllowDrop="True"
                              PreviewMouseLeftButtonDown="ChapterTree_PreviewMouseLeftButtonDown" PreviewMouseRightButtonUp="ChapterTree_RightClick"
                              PreviewKeyDown="ChapterTree_KeyDown" PreviewMouseMove="ChapterTree_PreviewMouseMove" Drop="ChapterTree_Drop">
                        <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <EventSetter Event="Collapsed" Handler="ChapterNode_Collapsed"/>
                        </Style></TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" Style="{DynamicResource WorkspaceSplitter}" ShowsPreview="True" ToolTip="拖动调整章节树与原文宽度；方向键微调" AutomationProperties.Name="调整章节树与原文宽度" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
            <Border Grid.Column="2" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="待核对" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="IssueOverviewSummaryText" Margin="8,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,10,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="IssueAllRadio" GroupName="IssueOverviewMode" Content="全部" Style="{StaticResource ChapterFilterRadio}" IsChecked="True" Click="IssueOverviewAll_Click"/>
                                <RadioButton x:Name="IssueActionableRadio" GroupName="IssueOverviewMode" Content="可处理" Style="{StaticResource ChapterFilterRadio}" Click="IssueOverviewActionable_Click"/>
                                <RadioButton x:Name="IssueConfirmRadio" GroupName="IssueOverviewMode" Content="需确认" Style="{StaticResource ChapterFilterRadio}" Click="IssueOverviewConfirm_Click"/>
                            </StackPanel>
                        </Border>
                        <ComboBox x:Name="IssueCategoryCombo" Grid.Column="1" Width="125" SelectedIndex="0" SelectionChanged="IssueCategory_Changed">
                            <ComboBoxItem Content="全部问题"/><ComboBoxItem Content="漏识别"/><ComboBoxItem Content="误识别"/><ComboBoxItem Content="重复"/><ComboBoxItem Content="编号与层级"/><ComboBoxItem Content="其他提醒"/>
                        </ComboBox>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button Tag="4" Click="IssueOverviewCard_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,12" Margin="0,0,0,4">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="↕" FontSize="22" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="章节错位" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="卷章顺序或位置需要核对" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
                                    <TextBlock x:Name="IssueRelocationCountText" Grid.Column="2" Text="0" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Button>
                            <Separator/>
                            <Button Tag="3" Click="IssueOverviewCard_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,12" Margin="0,4">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="▣" FontSize="20" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="完整章节重复" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="先对比正文，再选择保留哪一份" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
                                    <TextBlock x:Name="IssueDuplicateCountText" Grid.Column="2" Text="0" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Button>
                            <Separator/>
                            <Button Tag="1" Click="IssueOverviewCard_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,12" Margin="0,4">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="?" FontSize="21" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="标题缺失" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="正文边界需要确认，不能自动造章" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
                                    <TextBlock x:Name="IssueMissingCountText" Grid.Column="2" Text="0" FontSize="16" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Button>
                            <Separator/>
                            <Button Tag="5" Click="IssueOverviewCard_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,12" Margin="0,4">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="!" FontSize="20" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="正文未找到" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="保留缺失报告，等待人工定位" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
                                    <TextBlock x:Name="IssueBodyMissingCountText" Grid.Column="2" Text="0" FontSize="16" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="3" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="7" Padding="9,8" Margin="0,8,0,0">
                        <TextBlock Text="选择问题后，右侧显示证据、影响范围和下一步操作。" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Center" Style="{DynamicResource WorkspaceSplitter}" ShowsPreview="True" ToolTip="拖动调整待核对与证据面板宽度" AutomationProperties.Name="调整待核对与证据面板宽度" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
            <Border Grid.Column="4" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="225">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ReviewHeading" Text="选择章节，核对原文" FontSize="17" FontWeight="SemiBold"/>
                                <!--
                                  这条提醒属于哪一堆（§5.6"前者在后"）：和顶部那三个数字用的是
                                  同一个 IssueResolutionPolicy 判断，所以两边永远不会互相打架。
                                -->
                                <Border x:Name="ReviewBasisTag" Visibility="Collapsed" Margin="10,3,0,0"
                                        Padding="9,2" CornerRadius="10" VerticalAlignment="Center">
                                    <TextBlock x:Name="ReviewBasisTagText" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="ReviewExplanation" Text="点击左侧章节或选择待核对组。" TextWrapping="Wrap" MaxHeight="46" Margin="0,7,0,4" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <Expander x:Name="ReviewEvidenceExpander" Header="判断依据与原文位置" FontSize="11" Margin="0,0,0,6">
                                <StackPanel><TextBlock x:Name="ReviewDetailsText" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                    <ComboBox x:Name="GroupLocationsCombo" DisplayMemberPath="Label" SelectionChanged="GroupLocation_Changed" Margin="0,4,0,4"/>
                                    <WrapPanel x:Name="ReviewGroupControls"><Button x:Name="SelectReviewGroupButton" Content="选择本组全部章节" Click="SelectReviewGroup_Click"/><CheckBox x:Name="OnlyCurrentIssueCheck" Content="仅处理当前处" Click="OnlyCurrentIssue_Click" VerticalAlignment="Center"/></WrapPanel>
                                </StackPanel>
                            </Expander>
                            <TextBlock x:Name="ActionScopeText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,6"/>
                            <WrapPanel>
                                 <Button x:Name="ReviewActionButton" Content="编辑成品标题…" Click="ReviewAction_Click" IsEnabled="False" Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}"/>
                                 <Button x:Name="RecognizeNumericKeepButton" Content="仅识别，保留原标题" Click="RecognizeNumericKeep_Click" Visibility="Collapsed" ToolTip="只建立本书数字章节，不把成品标题改为“第X章”格式"/>
                                 <Button x:Name="ReviewMoreButton" Content="其他处理 ▾" Click="ReviewMore_Click"/>
                                 <Button x:Name="ReviewSequencePairsButton" Content="逐对核对本区段…" Click="ReviewSequencePairs_Click" Visibility="Collapsed" ToolTip="选择本区段的一对章节，打开正文对比；不会批量删除"/>
                                <Button x:Name="ConfirmNormalButton" Content="确认正常" Click="ConfirmNormal_Click" IsEnabled="False" ToolTip="仅本次窗口有效；更多→视图可恢复"/>
                            </WrapPanel>
                            <TextBlock x:Name="ReviewFeedback" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,4"/>
                            <Button x:Name="UndoResultButton" Content="撤销本次处理" Click="Undo_Click" Visibility="Collapsed" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1">
                        <Separator Margin="0,10,0,8"/>
                        <TextBlock x:Name="FinalTitleText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Visibility="Collapsed" Margin="0,0,0,5"/>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="RefreshSourceButton" Content="刷新原文" Click="RebuildFromRules_Click" Margin="0,0,8,0" Padding="8,4" MinHeight="28"/>
                                <Button x:Name="EditSourceButton" Content="编辑副本…" Click="EditSource_Click" Margin="0" Padding="8,4" MinHeight="28"/>
                            </StackPanel>
                            <TextBlock Text="原始文本" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SelectionHint" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                    <ListBox x:Name="SourceLinesList" Grid.Row="2" ItemsSource="{Binding SelectedLines}" BorderThickness="0" Background="{DynamicResource SubtleSurfaceBrush}"
                             FontFamily="Consolas, Microsoft YaHei UI" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SourceLinesList_SelectionChanged">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="3,3"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding LineNumber}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{DynamicResource PrimaryTextBrush}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=WrapSourceCheck}" Value="False"><Setter Property="TextWrapping" Value="NoWrap"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <WrapPanel Margin="0,0,0,8">
                            <CheckBox x:Name="WrapSourceCheck" Content="换行" IsChecked="True" Click="WrapSource_Click" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button Content="复制选中行" Click="CopySource_Click" FontSize="11" Padding="7,3" MinHeight="27"/>
                            <Button x:Name="ExpandSourceButton" Content="展开本章全文" Click="ExpandSource_Click" FontSize="11" Padding="7,3" MinHeight="27"/>
                            <Button x:Name="SplitButton" Content="从选中行建立章节" Click="Split_Click" IsEnabled="False" Visibility="Collapsed" FontSize="11" Padding="7,3" MinHeight="27"/>
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button x:Name="PreviousSuggestionButton" Content="← 上一组" Click="PreviousSuggestion_Click"/>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock x:Name="SuggestionCountText" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ComboBox x:Name="ChapterSuggestionsCombo" SelectionChanged="ChapterSuggestions_SelectionChanged" ToolTip="选择问题组定位；提醒不一定是错误">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Button x:Name="NextSuggestionButton" Grid.Column="2" Content="下一组 →" Click="NextSuggestion_Click" Margin="0"/>
                        </Grid>
                        <Button x:Name="LoadMoreIssuesButton" Content="继续加载提醒" Click="LoadMoreIssues_Click" Visibility="Collapsed" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="4">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Content="撤销" Click="Undo_Click" IsEnabled="False" Padding="8,4" MinHeight="28"
                        ToolTip="撤销本次章节修改（Ctrl+Z）"/>
                <Button x:Name="RedoButton" Content="重做" Click="Redo_Click" IsEnabled="False" Padding="8,4" MinHeight="28"
                        ToolTip="重做（Ctrl+Y）"/>
                <TextBlock Text="│" Foreground="{DynamicResource BorderBrush}" Margin="5,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="草稿尚未应用" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="14,0,0,0"><Button Content="取消" Click="Close_Click"/><Button x:Name="SaveChapterTreeButton" Content="应用并返回" Click="Save_Click" Margin="0" Padding="20,9" Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}"/></StackPanel>
            <TextBlock x:Name="SaveStateText" Text="本次修复：只改章节树（不碰 TXT）· 已保存" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/>
        </DockPanel>
        <Popup x:Name="ChapterActionsPopup" PlacementTarget="{Binding ElementName=ReviewMoreButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MinWidth="280">
                <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CurrentActionsPanel">
                        <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,1"/><Setter Property="BorderThickness" Value="0"/></Style></StackPanel.Resources>
                        <TextBlock Text="内容" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="8,4"/>
                        <Button x:Name="MergeButton" Content="还原为上一章正文" Click="Merge_Click" IsEnabled="False"/>
                        <Separator/><TextBlock Text="标题" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="8,4"/>
                        <Button x:Name="EditTitleButton" Content="编辑成品标题…" Click="EditCurrentTitle_Click"/>
                        <Button x:Name="CorrectNumberButton" Visibility="Collapsed" Click="CorrectNumber_Click"/>
                        <Separator/><TextBlock Text="层级（仍保留章节身份）" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="8,4"/>
                        <Button x:Name="DemoteButton" Content="设为上一章的子章节" Click="Demote_Click" IsEnabled="False"/>
                        <Button x:Name="PromoteButton" Content="移出父章节" Click="Promote_Click" IsEnabled="False"/>
                        <Separator/><TextBlock Text="顺序（单选）" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="8,4"/>
                        <Button x:Name="MoveUpButton" Content="上移" Click="MoveUp_Click" IsEnabled="False"/><Button x:Name="MoveDownButton" Content="下移" Click="MoveDown_Click" IsEnabled="False"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
        <Border x:Name="RulesStorage" Visibility="Collapsed">
            <StackPanel x:Name="RecognitionRulesPanel" Margin="16">
                <TextBlock x:Name="EffectiveRulesText" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock Text="普通章节 · 项目通用" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="留空使用内置规则：中文编号、卷章回节及独立的序章、番外等标题。项目通用设置不自动重建已保存章节树。" TextWrapping="Wrap" Margin="0,4,0,6"/>
                <Expander Header="自定义普通章节表达式" Margin="0,0,0,10"><StackPanel>
                <TextBox x:Name="ChapterPatternText" FontFamily="Consolas"/>
                <Button Content="恢复普通默认" Click="ResetChapterPattern_Click" HorizontalAlignment="Left" Margin="0,5,0,12"/>
                </StackPanel></Expander>
                <TextBlock Text="数字章节 · 本书 / 全局 / 方案" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock x:Name="NumericScopeText" TextWrapping="Wrap" Margin="0,4,0,6"/>
                <CheckBox x:Name="NumericHeadingsCheck" Content="识别数字章号（直接切换仅影响本书）" Margin="0,0,0,6"/>
                <WrapPanel Margin="0,0,0,6"><TextBlock Text="最少有效正文行数" VerticalAlignment="Center"/><TextBox x:Name="NumericMinimumLinesText" IsEnabled="{Binding IsChecked, ElementName=NumericHeadingsCheck}" Text="5" Width="55" Margin="8,0"/><TextBlock Text="0 不限；不含标题、空行及已移除行" VerticalAlignment="Center"/></WrapPanel>
                <Button Content="数字表达式与方案…" Click="NumericRules_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                <TextBlock Text="标题纠错 · 跳章区间检测" FontWeight="SemiBold" FontSize="16"/>
                <Button Content="标题纠错规则与方案…" Click="HeadingCorrections_Click" HorizontalAlignment="Left" Margin="0,6,0,12"/>
                <TextBlock Text="层级识别 · 项目通用" FontWeight="SemiBold" FontSize="16"/>
                <CheckBox x:Name="HierarchyEnabledCheck" Content="启用卷 / 章 / 节层级识别" Margin="0,6,0,8"/>
                <Expander Header="自定义卷 / 章 / 节表达式" IsEnabled="{Binding IsChecked, ElementName=HierarchyEnabledCheck}" Margin="0,0,0,10"><StackPanel>
                <TextBlock Text="一级（卷、部、篇）"/><TextBox x:Name="Level1PatternText" FontFamily="Consolas" Margin="0,4,0,6"/>
                <TextBlock Text="二级（章、回）"/><TextBox x:Name="Level2PatternText" FontFamily="Consolas" Margin="0,4,0,6"/>
                <TextBlock Text="三级（节）"/><TextBox x:Name="Level3PatternText" FontFamily="Consolas" Margin="0,4,0,6"/>
                <Button Content="恢复层级默认" Click="ResetRules_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                </StackPanel></Expander>
                <Expander Header="目录输出 · 项目通用" Margin="0,0,0,12"><StackPanel>
                <TextBlock Text="目录输出 · 项目通用" FontWeight="SemiBold" FontSize="16"/>
                <CheckBox x:Name="IncludeHtmlTocPageCheck" Content="在正文开头生成目录页" Margin="0,6,0,6" ToolTip="默认关闭；不影响阅读器导航目录"/>
                <CheckBox x:Name="IncludeChapterTopNavigationCheck" Content="每章标题上方显示章节导航" Margin="0,0,0,12" ToolTip="默认关闭"/>
                </StackPanel></Expander>
                <TextBlock Text="保留设置：保存供下次识别使用，当前章节树不变。重新识别：替换当前树，可撤销。最后点击工作台的“应用并返回”提交。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                <Button x:Name="RebuildRulesButton" Content="按当前规则重新识别…" Click="RebuildFromRules_Click" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
