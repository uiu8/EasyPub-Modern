<Window x:Class="EasyPub.Desktop.MetadataMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件夹元数据映射 · EasyPub Modern v1.15" Width="1220" Height="660" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="文件夹元数据映射" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="从规则文件夹或其子文件夹导入 TXT / EPUB 时，自动写入逐书元数据；子文件夹的规则优先。" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
        <Border Grid.Row="2" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
            <TextBlock Text="示例：文件夹 D:\小说\起点 → 出版社“起点”。之后从该目录添加的每一本书都会自动带上此出版社。" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
        </Border>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <DataGrid x:Name="RulesGrid" ItemsSource="{Binding Rules}" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" BorderThickness="0"
                      MouseDoubleClick="RulesGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="来源文件夹" Binding="{Binding FolderPath}" Width="*"/>
                    <DataGridTextColumn Header="作者" Binding="{Binding Metadata.Author}" Width="120"/>
                    <DataGridTextColumn Header="出版社" Binding="{Binding Metadata.Publisher}" Width="140"/>
                    <DataGridTextColumn Header="类别" Binding="{Binding Metadata.Category}" Width="110"/>
                    <DataGridTextColumn Header="语言" Binding="{Binding Metadata.Language}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="当前书稿命中预览" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock x:Name="PreviewSummaryText" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
                    <DataGrid x:Name="PreviewGrid" Grid.Row="2" ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" AutomationProperties.Name="当前书稿元数据映射预览">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="书稿" Binding="{Binding BookName}" Width="130"/>
                            <DataGridTextColumn Header="采用规则" Binding="{Binding MatchedRule.FolderPath}" Width="180"/>
                            <DataGridTextColumn Header="最终写入" Binding="{Binding AppliedValues}" Width="*"/>
                            <DataGridTextColumn Header="判定" Binding="{Binding Resolution}" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="6">
            <StackPanel Orientation="Horizontal">
            <Button Content="添加规则" Click="AddRule_Click" Background="{DynamicResource InfoSurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                <Button Content="编辑" Click="EditRule_Click"/>
                <Button Content="删除" Click="DeleteRule_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="Cancel_Click"/>
            <Button Content="保存规则" Click="Save_Click" Margin="0" Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}" BorderBrush="{DynamicResource PrimaryActionBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
