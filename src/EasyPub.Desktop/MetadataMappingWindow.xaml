<Window x:Class="EasyPub.Desktop.MetadataMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件夹元数据映射 · EasyPub Modern v0.21.3" Width="1050" Height="620" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F5F7FB" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/><Setter Property="BorderBrush" Value="#D0D7E2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="文件夹元数据映射" FontSize="25" FontWeight="SemiBold" Foreground="#172033"/>
            <TextBlock Text="从规则文件夹或其子文件夹导入 TXT / EPUB 时，自动写入逐书元数据；子文件夹的规则优先。" Margin="0,4,0,0" Foreground="#667085"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#EEF4FF" BorderBrush="#C7D7FE" BorderThickness="1" CornerRadius="10" Padding="12">
            <TextBlock Text="示例：文件夹 D:\小说\起点 → 出版社“起点”。之后从该目录添加的每一本书都会自动带上此出版社。" Foreground="#1D4ED8" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
            <DataGrid x:Name="RulesGrid" ItemsSource="{Binding Rules}" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" BorderThickness="0"
                      MouseDoubleClick="RulesGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="来源文件夹" Binding="{Binding FolderPath}" Width="*"/>
                    <DataGridTextColumn Header="作者" Binding="{Binding Metadata.Author}" Width="120"/>
                    <DataGridTextColumn Header="出版社" Binding="{Binding Metadata.Publisher}" Width="140"/>
                    <DataGridTextColumn Header="类别" Binding="{Binding Metadata.Category}" Width="110"/>
                    <DataGridTextColumn Header="语言" Binding="{Binding Metadata.Language}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="6">
            <StackPanel Orientation="Horizontal">
                <Button Content="＋ 添加规则" Click="AddRule_Click" Background="#EEF4FF" Foreground="#1D4ED8" BorderBrush="#C7D7FE"/>
                <Button Content="编辑" Click="EditRule_Click"/>
                <Button Content="删除" Click="DeleteRule_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="Cancel_Click"/>
                <Button Content="保存规则" Click="Save_Click" Margin="0" Background="#2563EB" Foreground="White" BorderBrush="#2563EB"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
