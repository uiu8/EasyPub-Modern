<Window x:Class="EasyPub.Desktop.IllustrationManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正文插图管理" Width="1080" Height="620" MinWidth="860" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" FontFamily="Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="＋ 添加图片" Click="Add_Click" Padding="14,7" Margin="0,0,8,0"/>
                <Button Content="选择插入位置" Click="ChoosePosition_Click" Padding="14,7" Margin="0,0,8,0" Background="{DynamicResource SelectedSurfaceBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button Content="改用手动标记" Click="UseManualMarker_Click" Padding="14,7" Margin="0,0,8,0"/>
                <Button Content="复制标记" Click="CopyMarker_Click" Padding="14,7" Margin="0,0,8,0"/>
                <Button Content="移除选中" Click="Remove_Click" Padding="14,7"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="正文插图" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock x:Name="BookNameText" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="2" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9">
            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"><Run Text="推荐：选中图片后点“选择插入位置”，直接在 TXT 预览中选择一行。也可以改用手动标记 "/><Run Text="[[插图:标记]]" FontFamily="Consolas" FontWeight="Bold"/><Run Text="。两种方式都不会修改原 TXT；JPG、PNG、WebP 会统一嵌入为 Kindle 兼容 JPEG。"/></TextBlock>
        </Border>
        <Border Grid.Row="4" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <DataGrid x:Name="IllustrationsGrid" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="标记" Binding="{Binding Marker, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                    <DataGridTextColumn Header="替代文字（可选）" Binding="{Binding AltText, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                    <DataGridTextColumn Header="图片文件" Binding="{Binding ImagePath}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="插入位置" Binding="{Binding PositionLabel}" IsReadOnly="True" Width="150"/>
                    <DataGridTextColumn Header="图片诊断" Binding="{Binding DiagnosticLabel}" IsReadOnly="True" Width="230"/>
                    <DataGridTextColumn Header="手动标记" Binding="{Binding MarkerToken}" IsReadOnly="True" Width="165"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <DockPanel Grid.Row="6">
            <TextBlock x:Name="CountText" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="取消" IsCancel="True" Padding="18,8" Margin="0,0,8,0"/>
                <Button Content="保存插图设置" IsDefault="True" Click="Save_Click" Padding="20,8" Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}" BorderBrush="{DynamicResource PrimaryActionBrush}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
