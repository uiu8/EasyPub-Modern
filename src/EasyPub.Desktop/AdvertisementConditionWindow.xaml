<Window x:Class="EasyPub.Desktop.AdvertisementConditionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加到广告规则 · EasyPub Modern" Width="720" Height="640" MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="添加到广告规则" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="选择处理方式 → 核对自动分析的影响 → 保存条件" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
        <StackPanel Grid.Row="2">
            <DockPanel Margin="0,0,0,12"><Button Content="管理已有条件…" DockPanel.Dock="Right" Click="ManageConditions_Click" Padding="10,5"/><TextBlock Text="1. 选择处理方式" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
            <ComboBox x:Name="IntentCombo" SelectionChanged="DraftChanged" SelectedIndex="0" Margin="0,0,0,12"><ComboBoxItem Content="作为广告：删除包含此文字的行"/><ComboBoxItem Content="始终保留：广告规则不删除包含此文字的行"/></ComboBox>
            <TextBlock Text="匹配文字（可缩短为关键片段，不需要正则）" Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBox x:Name="KeywordText" Margin="0,6,0,0" MinHeight="65" MaxHeight="105" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" MaxLength="2000" TextChanged="DraftChanged" AutomationProperties.Name="广告规则匹配文字"/>
        </StackPanel>
        <Border Grid.Row="4" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="2. 本书影响（自动分析）" FontWeight="SemiBold"/>
                <TextBlock x:Name="ImpactSummary" Grid.Row="1" TextWrapping="Wrap" Margin="0,8"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ImpactExamples" TextWrapping="Wrap"/></ScrollViewer>
            </Grid>
        </Border>
        <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="仅广告清理生效；其他规则与逐项排除仍有效。&#x0a;不会改写原 TXT，主窗口应用规则后才提交。" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" IsCancel="True" Padding="12,7" Margin="8,0"/><Button x:Name="SaveConditionButton" Content="保存条件" IsEnabled="False" Click="SaveCondition_Click" Padding="16,7" Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}"/></StackPanel>
        </Grid>
    </Grid>
</Window>
