<Window x:Class="EasyPub.Desktop.PreflightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="转换前检查 · EasyPub Modern v0.15.0" Width="880" Height="580" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="#F5F7FB" FontFamily="Microsoft YaHei UI">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="转换前检查" FontSize="25" FontWeight="SemiBold" Foreground="#172033"/>
            <TextBlock Text="在写入 EPUB / MOBI 前检查输入、章节、封面、输出冲突和 KindleGen。" Margin="0,4,0,0" Foreground="#667085"/>
        </StackPanel>
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="13">
            <DockPanel>
                <Border x:Name="ResultBadge" DockPanel.Dock="Right" CornerRadius="12" Padding="10,5"><TextBlock x:Name="ResultBadgeText" FontWeight="SemiBold"/></Border>
                <StackPanel><TextBlock x:Name="SummaryText" FontSize="16" FontWeight="SemiBold" Foreground="#344054"/><TextBlock x:Name="ChapterSummaryText" Margin="0,4,0,0" Foreground="#667085"/></StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
            <DataGrid x:Name="IssuesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" CanUserAddRows="False" MouseDoubleClick="IssuesGrid_MouseDoubleClick" SelectionChanged="IssuesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="级别" Binding="{Binding SeverityText}" Width="80"/>
                    <DataGridTextColumn Header="书稿" Binding="{Binding BookName}" Width="150"/>
                    <DataGridTextColumn Header="检查结果" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="LocateButton" Content="定位到设置" Padding="18,8" Margin="0,0,8,0" Click="Locate_Click" IsEnabled="False"/>
            <Button Content="关闭" Padding="18,8" Margin="0,0,8,0" Click="Close_Click"/>
            <Button x:Name="ContinueButton" Content="继续转换" Padding="20,8" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</Window>
