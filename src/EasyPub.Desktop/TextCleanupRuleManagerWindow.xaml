<Window x:Class="EasyPub.Desktop.TextCleanupRuleManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义文本清理规则 · EasyPub Modern" Width="1120" Height="700" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="RuleCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/></Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="自定义文本清理规则" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="按顺序执行普通替换或正则规则；所有规则只作用于转换副本，不修改原始 TXT。" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource RuleCard}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DataGrid x:Name="RulesGrid" ItemsSource="{Binding}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionChanged="RulesGrid_SelectionChanged" BorderThickness="0">
                    <DataGrid.Columns><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="58"/><DataGridTextColumn Header="顺序" Binding="{Binding Order}" Width="58" IsReadOnly="True"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="类型" Binding="{Binding TypeLabel}" Width="78" IsReadOnly="True"/><DataGridTextColumn Header="范围" Binding="{Binding ScopeLabel}" Width="98" IsReadOnly="True"/></DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12"><Button Content="＋ 添加" Click="Add_Click"/><Button Content="删除" Margin="8,0,0,0" Click="Delete_Click"/><Button Content="上移" Margin="8,0,0,0" Click="MoveUp_Click"/><Button Content="下移" Margin="8,0,0,0" Click="MoveDown_Click"/></StackPanel>
            </Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource RuleCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="规则编辑" FontSize="17" FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="名称" VerticalAlignment="Center"/><TextBox x:Name="RuleNameText" Grid.Column="1"/><TextBlock Grid.Column="2" Text="执行顺序由左侧排列决定" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></Grid>
                <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="作用范围" VerticalAlignment="Center"/><ComboBox x:Name="RuleScopeCombo" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="全部内容" Tag="All"/><ComboBoxItem Content="仅正文" Tag="BodyOnly"/><ComboBoxItem Content="仅章节标题" Tag="ChapterTitlesOnly"/></ComboBox><TextBlock Grid.Column="2" Text="规则类型" VerticalAlignment="Center" Margin="14,0,0,0"/><ComboBox x:Name="RuleTypeCombo" Grid.Column="3" SelectedIndex="0"><ComboBoxItem Content="普通替换" Tag="Literal"/><ComboBoxItem Content="正则表达式" Tag="Regex"/></ComboBox></Grid>
                <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="匹配内容"/><TextBox x:Name="RulePatternText" Margin="0,6,0,0" AcceptsReturn="True" Height="72" VerticalScrollBarVisibility="Auto"/></StackPanel>
                <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="替换内容（允许留空表示删除）"/><TextBox x:Name="RuleReplacementText" Margin="0,6,0,0" AcceptsReturn="True" Height="62" VerticalScrollBarVisibility="Auto"/></StackPanel>
                <WrapPanel Grid.Row="5" Margin="0,12,0,0"><CheckBox x:Name="RuleEnabledCheck" Content="启用" IsChecked="True" Margin="0,0,22,0"/><CheckBox x:Name="IgnoreCaseCheck" Content="忽略大小写" Margin="0,0,22,0"/><CheckBox x:Name="MultilineCheck" Content="跨行模式"/><Button Content="更新当前规则" Margin="28,0,0,0" Click="SaveRule_Click"/></WrapPanel>
                <Border Grid.Row="6" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,14,0,0"><StackPanel><TextBlock Text="安全测试" FontWeight="SemiBold"/><TextBlock Text="正则执行时间限制为 250 毫秒。更新规则时会检查语法，并按作用范围统计当前书稿的真实命中数量。" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><TextBlock x:Name="RuleTestResultText" Margin="0,12,0,0" Text="尚未测试" FontWeight="SemiBold"/></StackPanel></Border>
            </Grid></Border>
        </Grid>
        <Grid Grid.Row="4"><StackPanel Orientation="Horizontal"><Button Content="导入规则组" Click="Import_Click"/><Button Content="导出规则组" Margin="8,0,0,0" Click="Export_Click"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="取消" Click="Cancel_Click"/><Button Content="应用规则组" Margin="8,0,0,0" Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}" BorderBrush="{DynamicResource PrimaryActionBrush}" Click="Apply_Click"/></StackPanel></Grid>
    </Grid>
</Window>
