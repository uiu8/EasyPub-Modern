                    </Grid>

                    <Grid x:Name="InkLayoutPage" Visibility="Collapsed" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="12"/><ColumnDefinition Width="390"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="设置项目" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><RadioButton x:Name="LayoutBaseNav" GroupName="LayoutSection" Content="基础版式" Tag="&#xE8D2;" IsChecked="True" Style="{StaticResource MiniNav}" Checked="LayoutSection_Checked"/><RadioButton x:Name="LayoutMarginsNav" GroupName="LayoutSection" Content="页边距" Tag="&#xE7C8;" Style="{StaticResource MiniNav}" Checked="LayoutSection_Checked"/><RadioButton x:Name="LayoutFontNav" GroupName="LayoutSection" Content="字体" Tag="&#xE8D2;" Style="{StaticResource MiniNav}" Checked="LayoutSection_Checked"/><RadioButton x:Name="LayoutChapterNav" GroupName="LayoutSection" Content="章节标题" Tag="&#xE8A5;" Style="{StaticResource MiniNav}" Checked="LayoutSection_Checked"/><RadioButton x:Name="LayoutCssNav" GroupName="LayoutSection" Content="自定义 CSS" Tag="&#xE943;" Style="{StaticResource MiniNav}" Checked="LayoutSection_Checked"/><RadioButton x:Name="LayoutIllustrationNav" GroupName="LayoutSection" Content="正文插图" Tag="&#xEB9F;" Style="{StaticResource MiniNav}" Checked="LayoutSection_Checked"/><Button Content="管理排版方案" Tag="&#xE713;" Click="ManagePresets_Click" HorizontalContentAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><Grid>
                            <StackPanel x:Name="LayoutBasePanel"><TextBlock Text="基础版式" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="选择整体阅读密度；下方数值会同步到书页预览。" Margin="0,6,0,12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><StackPanel x:Name="ModeAndPresetPanel" Orientation="Horizontal"><RadioButton x:Name="OriginalModeRadio" GroupName="ConversionMode" Content="原版兼容" IsChecked="True" Checked="ConversionMode_Checked" Margin="0,0,14,0"/><RadioButton x:Name="ModernModeRadio" GroupName="ConversionMode" Content="现代排版" Checked="ConversionMode_Checked" Margin="0,0,14,0"/><RadioButton x:Name="CustomModeRadio" GroupName="ConversionMode" Content="自定义" Checked="ConversionMode_Checked"/></StackPanel><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="正文字号（%）" VerticalAlignment="Center"/><TextBox x:Name="FontSizeText" Grid.Column="1" Text="110" TextChanged="LayoutPreviewSetting_Changed"/></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="行高（%）" VerticalAlignment="Center"/><TextBox x:Name="LineHeightText" Grid.Column="1" Text="120" TextChanged="LayoutPreviewSetting_Changed"/></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="段间距（em）" VerticalAlignment="Center"/><TextBox x:Name="ParagraphSpacingText" Grid.Column="1" Text="0.6" TextChanged="LayoutPreviewSetting_Changed"/></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="首行缩进（em）" VerticalAlignment="Center"/><TextBox x:Name="IndentText" Grid.Column="1" Text="0" TextChanged="LayoutPreviewSetting_Changed"/></Grid><CheckBox x:Name="FullWidthIndentCheck" Content="保留两个全角空格" IsChecked="True" Margin="0,15,0,0" Click="LayoutPreviewSetting_Click"/><CheckBox x:Name="KeepBlankLinesCheck" Content="保留空行" Margin="0,10,0,0" Click="LayoutPreviewSetting_Click"/><Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="7" Padding="12" Margin="0,16,0,0"><StackPanel><TextBlock x:Name="ModeDescriptionText" Text="原版兼容：复现原版 EasyPub 的正文密度与缩进习惯。" TextWrapping="Wrap"/><TextBlock x:Name="ModeParameterText" Visibility="Collapsed"/></StackPanel></Border></StackPanel>
                            <StackPanel x:Name="LayoutMarginsPanel" Visibility="Collapsed"><TextBlock Text="页边距" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="单位为 px。修改后会立即反映到右侧书页。" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryTextBrush}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="上边距" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VisibleMarginTopText" TextChanged="VisibleMarginText_Changed"/><TextBlock Text="左边距" Style="{StaticResource FieldLabel}" Margin="0,14,0,7"/><TextBox x:Name="VisibleMarginLeftText" TextChanged="VisibleMarginText_Changed"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="下边距" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VisibleMarginBottomText" TextChanged="VisibleMarginText_Changed"/><TextBlock Text="右边距" Style="{StaticResource FieldLabel}" Margin="0,14,0,7"/><TextBox x:Name="VisibleMarginRightText" TextChanged="VisibleMarginText_Changed"/></StackPanel></Grid><TextBlock Text="正文对齐" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/><ComboBox x:Name="VisibleAlignmentCombo" SelectedIndex="0" SelectionChanged="VisibleAlignmentCombo_SelectionChanged"><ComboBoxItem Content="默认（跟随阅读器）"/><ComboBoxItem Content="两端对齐"/></ComboBox></StackPanel>
                            <StackPanel x:Name="LayoutFontPanel" Visibility="Collapsed"><TextBlock Text="字体" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="可选嵌入 TTF 字体；转换前会检查嵌入许可。" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><CheckBox x:Name="VisibleEmbedFontCheck" Content="在电子书中嵌入字体" Click="VisibleFontSetting_Changed"/><TextBlock Text="字体文件" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/><DockPanel><Button Content="选择" Tag="&#xE8B7;" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseVisibleFont_Click"/><TextBox x:Name="VisibleFontPathText" IsReadOnly="True"/></DockPanel><TextBlock Text="字体家族名称" Style="{StaticResource FieldLabel}" Margin="0,14,0,7"/><TextBox x:Name="VisibleFontFamilyText" TextChanged="VisibleFontSetting_TextChanged"/><CheckBox x:Name="VisibleSubsetFontCheck" Content="仅嵌入书中实际使用的字符" IsChecked="True" Margin="0,14,0,0" Click="VisibleFontSetting_Changed"/><TextBlock x:Name="VisibleFontStatusText" Margin="0,16,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><Button Content="清除字体设置" HorizontalAlignment="Left" Margin="0,16,0,0" Click="ClearVisibleFont_Click"/></StackPanel>
                            <StackPanel x:Name="LayoutChapterPanel" Visibility="Collapsed"><TextBlock Text="章节标题" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="用于 TXT 章节识别。留空时使用内置中文章节规则。" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><TextBlock Text="章节标题正则" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VisibleChapterRegexText" AcceptsReturn="True" MinHeight="120" VerticalContentAlignment="Top" TextWrapping="Wrap" TextChanged="VisibleChapterRegexText_Changed"/><TextBlock Text="示例：^第[一二三四五六七八九十百千万0-9]+[章节卷].*$" Margin="0,12,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel x:Name="LayoutCssPanel" Visibility="Collapsed"><TextBlock Text="自定义 CSS" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="为 EPUB/MOBI 正文追加样式；保存后参与下一次转换。" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="8" Padding="14"><TextBlock x:Name="VisibleCssSummaryText" Text="未设置" TextWrapping="Wrap"/></Border><Button Content="打开 CSS 编辑器" Tag="&#xE70F;" HorizontalAlignment="Left" Margin="0,16,0,0" Click="EditCss_Click"/></StackPanel>
                            <StackPanel x:Name="LayoutIllustrationPanel" Visibility="Collapsed"><TextBlock Text="正文插图" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="为当前选中的 TXT 书稿选择图片，并精确定位到正文段落之间。WebP 会在生成时转换为 Kindle 兼容 JPEG。" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="8" Padding="14"><TextBlock x:Name="VisibleIllustrationSummaryText" Text="请先在书库中只选中一本 TXT 书稿" TextWrapping="Wrap"/></Border><Button x:Name="InkManageIllustrationsButton" Content="管理所选书稿插图" Tag="&#xEB9F;" AutomationProperties.Name="管理所选小说插图" Click="EditIllustrations_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel>
                        </Grid></Border>
                        <Border Grid.Column="4" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Kindle 书页预览" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="PreviewDeviceStatusText" Text="Kindle Paperwhite 6 · 1264 × 1680" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><DockPanel Grid.Row="1" Margin="0,10,0,0"><TextBlock Text="Kindle 型号" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/><ComboBox x:Name="KindleModelCombo" DockPanel.Dock="Right" Width="250" DisplayMemberPath="DisplayName" SelectionChanged="KindleModelCombo_SelectionChanged"/></DockPanel><Grid x:Name="CustomKindleSizePanel" Grid.Row="2" Margin="0,9,0,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="CustomKindleWidthText" Text="1264" ToolTip="宽度（像素）" TextChanged="CustomKindleSize_Changed"/><TextBox x:Name="CustomKindleHeightText" Grid.Column="2" Text="1680" ToolTip="高度（像素）" TextChanged="CustomKindleSize_Changed"/><TextBox x:Name="CustomKindlePpiText" Grid.Column="4" Text="300" ToolTip="PPI" TextChanged="CustomKindleSize_Changed"/></Grid><ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="4,12"><Border x:Name="PreviewDeviceFrame" Width="360" Height="480" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#F4EEDC" BorderBrush="#C9BFA9" BorderThickness="1" Padding="38" CornerRadius="3"><StackPanel><TextBlock x:Name="LayoutPreviewTitle" Text="第一章　书页预览" HorizontalAlignment="Center" FontFamily="SimSun" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,24" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock x:Name="LayoutPreviewBody" Text="　　这里会显示所选书稿的真实正文片段。&#x0a;&#x0a;　　调整字号、行高、段间距和页边距后，预览会立即更新。" FontFamily="SimSun" FontSize="16" LineHeight="29" TextWrapping="Wrap" Foreground="#28251F"/></StackPanel></Border></ScrollViewer><Grid Grid.Row="4" Margin="0,2,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="PreviousLayoutPreviewPageButton" Content="上一页" Tag="&#xE76B;" Click="PreviousLayoutPreviewPage_Click" HorizontalAlignment="Left" MinHeight="32" Padding="10,5" AutomationProperties.Name="Kindle 预览上一页"/><TextBlock x:Name="LayoutPreviewPageText" Grid.Column="1" Text="第 1 / 1 页" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource SecondaryTextBrush}"/><Button x:Name="NextLayoutPreviewPageButton" Grid.Column="2" Content="下一页" Tag="&#xE76C;" Click="NextLayoutPreviewPage_Click" HorizontalAlignment="Right" MinHeight="32" Padding="10,5" AutomationProperties.Name="Kindle 预览下一页"/></Grid><StackPanel Grid.Row="5" Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0"/><TextBlock Text="分页为近似校对；最终分页仍以 Kindle 真机为准" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel></Grid></Border>
                    </Grid>

                    <Grid x:Name="InkConvertPage" Visibility="Collapsed" Margin="16"><Grid.RowDefinitions><RowDefinition Height="95"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="44"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="已选择的书稿" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="章节、封面和排版设置已准备" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel><ItemsControl Grid.Column="1" ItemsSource="{Binding InputBooks}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,28,0"><Border Width="42" Height="58" CornerRadius="4" Background="{DynamicResource SelectedSurfaceBrush}" ClipToBounds="True"><Image Source="{Binding CoverThumbnail}" Stretch="UniformToFill"/></Border><StackPanel Margin="10,6,0,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" MaxWidth="170" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FormatLabel}" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="OutputSection" Style="{StaticResource Card}"><StackPanel><TextBlock Text="输出设置" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="输出目录" Margin="0,18,0,7" Foreground="{DynamicResource SecondaryTextBrush}"/><DockPanel><Button Content="浏览" Tag="&#xE8B7;" DockPanel.Dock="Right" Click="BrowseOutput_Click" Margin="8,0,0,0"/><TextBox x:Name="OutputDirectoryText"/></DockPanel><TextBlock Text="目标格式" Margin="0,16,0,7" Foreground="{DynamicResource SecondaryTextBrush}"/><ComboBox x:Name="ConvertFormatCombo" SelectedIndex="1" SelectionChanged="ConvertFormatCombo_SelectionChanged"><ComboBoxItem Content="EPUB"/><ComboBoxItem Content="MOBI"/></ComboBox><TextBlock Text="并发任务数" Margin="0,14,0,7" Foreground="{DynamicResource SecondaryTextBrush}"/><ComboBox x:Name="ParallelismCombo" SelectedIndex="0"><ComboBoxItem Content="自动（按电脑资源）" Tag="0"/><ComboBoxItem Content="1" Tag="1"/><ComboBoxItem Content="2" Tag="2"/><ComboBoxItem Content="4" Tag="4"/><ComboBoxItem Content="8" Tag="8"/><ComboBoxItem Content="12" Tag="12"/><ComboBoxItem Content="16" Tag="16"/><ComboBoxItem Content="32" Tag="32"/></ComboBox><TextBlock Text="同名文件处理" Margin="0,14,0,7" Foreground="{DynamicResource SecondaryTextBrush}"/><ComboBox x:Name="OutputCollisionCombo" SelectedIndex="0"><ComboBoxItem Content="自动改名（推荐）" Tag="AutoRename"/><ComboBoxItem Content="覆盖旧文件" Tag="Overwrite"/><ComboBoxItem Content="跳过已有文件" Tag="Skip"/></ComboBox><CheckBox x:Name="AutoOpenOutputDirectoryCheck" Content="转换完成后打开输出目录" IsChecked="True" Margin="0,14,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="转换引擎" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="●  KindleGen 已就绪" Margin="0,18,0,0" Foreground="#4C9B39"/><TextBlock Text="KindleGen 路径" Margin="0,16,0,7" Foreground="{DynamicResource SecondaryTextBrush}"/><DockPanel><Button Content="更换" DockPanel.Dock="Right" Click="BrowseKindleGen_Click" Margin="8,0,0,0"/><TextBox x:Name="KindleGenText" IsReadOnly="True"/></DockPanel><TextBlock Text="压缩级别" Margin="0,16,0,7" Foreground="{DynamicResource SecondaryTextBrush}"/><ComboBox x:Name="CompressionCombo" SelectedIndex="1"><ComboBoxItem Content="0 - 无" Tag="0"/><ComboBoxItem Content="1 - 标准" Tag="1"/><ComboBoxItem Content="2 - 高" Tag="2"/></ComboBox><CheckBox x:Name="ArtifactValidationCheck" Content="转换后执行结构验收（较慢）" Margin="0,16,0,0" Click="ArtifactValidationCheck_Click"/><Expander Header="高级参数" Margin="0,16,0,0"><StackPanel Margin="0,10,0,0"><CheckBox x:Name="StripSourceCheck" IsChecked="True" Content="移除附加源文件"/><CheckBox x:Name="MobiSyncCheck" IsChecked="True" Content="写入 ASIN/EBOK" Margin="0,8,0,0"/><TextBox x:Name="MobiAsinText" Margin="0,8,0,0" ToolTip="固定 ASIN（可选）"/><TextBox x:Name="KindleGenArgsText" Margin="0,8,0,0" ToolTip="额外 KindleGen 参数"/></StackPanel></Expander><Separator Margin="0,14,0,10"/><TextBlock Text="原版 EasyPub config.xml" FontWeight="SemiBold"/><TextBlock x:Name="LegacyConfigStatusText" Text="尚未选择；可导入原版排版与转换设置" Margin="0,5,0,9" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><WrapPanel><Button x:Name="BrowseLegacyConfigButton" Content="选择 config.xml" Click="BrowseLegacyConfig_Click" Padding="11,6" MinHeight="32"/><Button x:Name="ClearLegacyConfigButton" Content="取消选择" Click="ClearLegacyConfig_Click" Padding="11,6" MinHeight="32" Margin="6,0,0,0"/><Button x:Name="ShowLegacyConfigDetailsButton" Content="查看映射" Click="ShowLegacyConfigDetails_Click" Padding="11,6" MinHeight="32" Margin="6,0,0,0"/></WrapPanel></StackPanel></Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="本次转换" FontSize="16" FontWeight="SemiBold"/><ListBox Grid.Row="1" ItemsSource="{Binding InputBooks}" BorderThickness="0" Background="Transparent" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FormatLabel}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="就绪" Foreground="#4C9B39" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="2" Text="转换前检查通过后即可开始" Foreground="{DynamicResource SecondaryTextBrush}"/></Grid></Border></Grid>
                        <Border Grid.Row="4" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="7" Padding="12"><DockPanel><TextBlock Text="✓  转换前检查状态会显示在这里" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="查看检查结果  ›" Click="RunPreflight_Click" Padding="10,4" MinHeight="28" Background="Transparent" BorderThickness="0"/></DockPanel></Border>
                    </Grid>

                    <Grid x:Name="TaskCenterLanding" Visibility="Collapsed" Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="当前任务、检查结果和转换历史" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/><Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,8"><DockPanel><TextBlock Text="进行中"/><TextBlock DockPanel.Dock="Right" Text="0" FontWeight="SemiBold"/></DockPanel></Border><Border Grid.Column="3" Style="{StaticResource Card}" Padding="14,8"><DockPanel><TextBlock Text="已完成"/><TextBlock DockPanel.Dock="Right" Text="0" FontWeight="SemiBold"/></DockPanel></Border><Border Grid.Column="5" Style="{StaticResource Card}" Padding="14,8"><DockPanel><TextBlock Text="失败"/><TextBlock DockPanel.Dock="Right" Text="0" FontWeight="SemiBold"/></DockPanel></Border></Grid><Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="{DynamicResource SubtleSurfaceBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="180"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="书名" Margin="12,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="阶段" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="进度" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="验收" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="输出" VerticalAlignment="Center"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding BookTasks}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Grid Height="66"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="180"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><ProgressBar Width="120" Height="8" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"/><TextBlock Text="{Binding Progress, StringFormat={}{0:P0}}" Margin="8,0,0,0"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding ValidationText}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding OutputName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border></Grid>
                </Grid></ScrollViewer>
            </Grid></Border>
        </Grid>

        <Border x:Name="BottomOperationBar" Grid.Row="6" Style="{StaticResource Card}" Padding="14,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="输出格式" VerticalAlignment="Center" Margin="0,0,9,0"/><ComboBox x:Name="FormatCombo" Width="126" SelectedIndex="1" SelectionChanged="FormatCombo_SelectionChanged"><ComboBoxItem Content="EPUB"/><ComboBoxItem Content="MOBI"/></ComboBox></StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="排版方案" VerticalAlignment="Center" Margin="0,0,9,0"/><ComboBox x:Name="LayoutModeCombo" Width="178" SelectedIndex="0" SelectionChanged="LayoutModeCombo_SelectionChanged"><ComboBoxItem Content="原版兼容"/><ComboBoxItem Content="现代排版"/><ComboBoxItem Content="自定义"/></ComboBox><Button x:Name="ManagePresetButton" Content="" Tag="&#xE713;" ToolTip="管理已保存方案" Width="42" Padding="8" Margin="6,0,0,0" Click="ManagePresets_Click"/></StackPanel>
            <Border x:Name="StatusPanel" Grid.Column="4" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12,7" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="26" Height="26" Background="{DynamicResource SelectedSurfaceBrush}" CornerRadius="13"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}"/></Border><StackPanel Grid.Column="1"><ProgressBar x:Name="Progress" Height="4" HorizontalAlignment="Stretch" Minimum="0" Maximum="1" Foreground="{DynamicResource PrimaryActionBrush}"/><TextBlock x:Name="StatusText" Margin="0,4,0,0" Text="准备就绪，可添加或拖入多个 TXT / EPUB 文件" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
            <StackPanel Grid.Column="6" Orientation="Horizontal"><Button x:Name="RetryFailedButton" Content="重试失败项" Click="RetryFailed_Click" IsEnabled="False" Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}"/><Button x:Name="RunPreflightButton" Content="检查问题" Tag="&#xEA18;" Margin="8,0" Click="RunPreflight_Click" IsEnabled="False"/><Button x:Name="PauseButton" Content="暂停" Click="PauseResume_Click" IsEnabled="False" Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}"/><Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False" Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}"/><Button x:Name="ConvertButton" Content="开始批量转换" Tag="&#xE72A;" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="Convert_Click" IsEnabled="False" AutomationProperties.Name="开始批量转换"/></StackPanel>
        </Grid></Border>

        <Grid Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition x:Name="BookListRow" Height="0"/></Grid.RowDefinitions><Border x:Name="FavoriteFolderSection"><StackPanel><ComboBox x:Name="FavoriteFolderCombo" ItemsSource="{Binding FavoriteFolders}" SelectionChanged="FavoriteFolderCombo_SelectionChanged"/><Button x:Name="AddFromFavoriteButton" Click="AddFromFavoriteFolder_Click"/><Button x:Name="RemoveFavoriteButton" Click="RemoveFavoriteFolder_Click"/></StackPanel></Border><ComboBox x:Name="BookFilterCombo" SelectedIndex="0"><ComboBoxItem Content="全部书稿" Tag="All"/><ComboBoxItem Content="有错误或提醒" Tag="Issues"/><ComboBoxItem Content="尚未检查" Tag="Unchecked"/><ComboBoxItem Content="缺少封面" Tag="NoCover"/><ComboBoxItem Content="TXT" Tag="Txt"/><ComboBoxItem Content="EPUB" Tag="Epub"/></ComboBox><ComboBox x:Name="BookSortCombo" SelectedIndex="0"><ComboBoxItem Content="导入顺序" Tag="Input"/><ComboBoxItem Content="书名 A–Z" Tag="Name"/><ComboBoxItem Content="问题优先" Tag="Issues"/></ComboBox>
            <Grid x:Name="ConversionOptionsSection"><TabControl x:Name="OptionsTabs"><TabItem x:Name="ChaptersTab" Header="章节"><ComboBox x:Name="EncodingCombo" SelectedIndex="0"><ComboBoxItem Content="自动检测" Tag="Auto"/><ComboBoxItem Content="UTF-8" Tag="Utf8"/><ComboBoxItem Content="GBK" Tag="Gbk"/></ComboBox></TabItem><TabItem x:Name="LayoutTab" Header="版式"><Grid><TextBox x:Name="PageMarginTopText" Text="0"/><TextBox x:Name="PageMarginBottomText" Text="0"/><TextBox x:Name="PageMarginLeftText" Text="3"/><TextBox x:Name="PageMarginRightText" Text="3"/><ComboBox x:Name="AlignmentCombo" SelectedIndex="0"><ComboBoxItem Content="默认" Tag="Default"/><ComboBoxItem Content="两端" Tag="Justify"/></ComboBox></Grid></TabItem><TabItem x:Name="FontTab" Header="字体"><StackPanel><CheckBox x:Name="EmbedFontCheck"/><TextBox x:Name="FontPathText"/><TextBox x:Name="FontFamilyText"/><CheckBox x:Name="SubsetFontCheck" IsChecked="True"/><TextBlock x:Name="FontStatusText"/></StackPanel></TabItem><TabItem x:Name="MetadataTab" Header="书籍信息"/><TabItem x:Name="CssTab" Header="定制 CSS"><TextBlock x:Name="CssSummaryText"/></TabItem><TabItem x:Name="IllustrationsTab" Header="插图"/><TabItem x:Name="MobiTab" Header="MOBI"><ComboBox x:Name="EpubModeCombo" SelectedIndex="0"><ComboBoxItem Content="保留原 EPUB 版式" Tag="PreserveOriginal"/><ComboBoxItem Content="EasyPub 兼容重排" Tag="EasyPubCompatible"/></ComboBox></TabItem><TabItem x:Name="AdvancedTab" Header="高级"><Border x:Name="AdvancedOptionsContent"><StackPanel><TextBox x:Name="ChapterRegexText"/><Grid x:Name="ValidationOptionsPanel"><ComboBox x:Name="ValidationRetentionCombo" SelectedIndex="1" IsEnabled="False"><ComboBoxItem Content="5 条" Tag="5"/><ComboBoxItem Content="10 条" Tag="10"/><ComboBoxItem Content="20 条" Tag="20"/><ComboBoxItem Content="50 条" Tag="50"/></ComboBox></Grid><CheckBox x:Name="AutoOpenTaskCenterCheck"/></StackPanel></Border></TabItem></TabControl></Grid>
            <Grid><TextBlock x:Name="ModeLabelText"/><TextBlock x:Name="PresetLabelText"/><ComboBox x:Name="PresetCombo" ItemsSource="{Binding ConversionPresets}" DisplayMemberPath="Name" SelectionChanged="PresetCombo_SelectionChanged"/><TextBlock x:Name="PerBookSummaryText"/></Grid>
        </Grid>
    </Grid>
</Window>
