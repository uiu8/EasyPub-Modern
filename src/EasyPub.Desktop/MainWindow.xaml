<Window x:Class="EasyPub.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyPub Modern v0.17.2" Width="1180" Height="900" MinWidth="960" MinHeight="780"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" AllowDrop="True"
        FontFamily="Microsoft YaHei UI" TextOptions.TextFormattingMode="Display"
        Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#172033"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#667085"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E2E8F0"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="24,11"/><Setter Property="MinHeight" Value="44"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EEF4FF"/><Setter Property="BorderBrush" Value="#C7D7FE"/><Setter Property="Foreground" Value="#1D4ED8"/>
        </Style>
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#ECFDF3"/><Setter Property="BorderBrush" Value="#A7E3C1"/><Setter Property="Foreground" Value="#067647"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,6"/><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D7E2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="36"/><Setter Property="BorderBrush" Value="#D0D7E2"/><Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#344054"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Foreground" Value="#475467"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="BookListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="6,3"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Padding="10,8" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EAF2FF"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#AFCBFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#475467"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Background="#F8FAFC"
                                BorderBrush="#E2E8F0" BorderThickness="1,1,1,0" CornerRadius="7,7,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#EEF4FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource AccentBrush}">
                <TextBlock Text="E" FontSize="25" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="EasyPub Modern" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Margin="0,3,0,0" Text="TXT / EPUB 到 Kindle · 章节树、封面、正文插图与定制排版" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Menu Margin="0,0,8,0" VerticalAlignment="Center" Background="White">
                    <MenuItem Header="项目" ToolTip="保存书稿列表、封面、插图、逐书信息和转换设置，方便下次继续">
                        <MenuItem Header="保存当前工作，方便下次继续" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem Header="新建项目" Click="NewProject_Click"/>
                        <MenuItem Header="打开项目…" Click="OpenProject_Click"/>
                        <Separator/>
                        <MenuItem Header="保存项目" Click="SaveProject_Click"/>
                        <MenuItem Header="项目另存为…" Click="SaveProjectAs_Click"/>
                    </MenuItem>
                </Menu>
                <Button Content="整书预览" Click="PreviewBook_Click" Style="{StaticResource AccentButton}"/>
                <Button Content="转换历史" Click="ShowHistory_Click" Margin="0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                    <RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                    <RowDefinition Height="285"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="＋ 添加 TXT / EPUB" Click="AddFiles_Click" Style="{StaticResource AccentButton}"/>
                        <Button Content="导入文件夹" Click="ImportFolder_Click"/>
                        <Button Content="全选" Click="SelectAllFiles_Click"/>
                        <Button Content="移除选中" Click="RemoveSelected_Click"/>
                        <Button Content="清空" Click="ClearFiles_Click" Margin="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="1  选择书稿" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <Border Margin="10,0,0,0" Background="#F2F4F7" CornerRadius="12" Padding="9,4"><TextBlock x:Name="FileCountText" Text="0 本" Foreground="#475467" FontSize="12" FontWeight="SemiBold"/></Border>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="★" Foreground="#F59E0B" FontSize="17" Margin="0,0,7,0"/>
                            <StackPanel><TextBlock Text="收藏文件夹" FontWeight="SemiBold" Foreground="#344054"/><TextBlock Text="快速进入常用小说目录" FontSize="11" Foreground="#98A2B3"/></StackPanel>
                        </StackPanel>
                        <ComboBox x:Name="FavoriteFolderCombo" Grid.Column="2" ItemsSource="{Binding FavoriteFolders}" SelectionChanged="FavoriteFolderCombo_SelectionChanged" ToolTip="选择常用小说目录"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button x:Name="AddFromFavoriteButton" Content="从此文件夹添加" Click="AddFromFavoriteFolder_Click" IsEnabled="False" Style="{StaticResource GreenButton}"/>
                            <Button Content="添加收藏" Click="AddFavoriteFolder_Click"/>
                            <Button x:Name="RemoveFavoriteButton" Content="移除收藏" Click="RemoveFavoriteFolder_Click" IsEnabled="False" Margin="0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="278"/></Grid.ColumnDefinitions>
                    <Border BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="10" Background="#FCFDFE">
                        <Grid>
                            <ListBox x:Name="FilesList" ItemsSource="{Binding InputBooks}" SelectionMode="Extended" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource BookListItem}" SelectionChanged="FilesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="8" Background="#EEF4FF" VerticalAlignment="Center"><TextBlock Text="文" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#172033" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DirectoryPath}" Foreground="#98A2B3" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding InputPath}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#ECFDF3" CornerRadius="10" Padding="7,3" Margin="0,0,7,0" Visibility="{Binding CoverBadgeVisibility}"><TextBlock Text="有封面" Foreground="#067647" FontSize="11" FontWeight="SemiBold"/></Border>
                                                <Border Background="#FFF7ED" CornerRadius="10" Padding="7,3" Margin="0,0,7,0" Visibility="{Binding IllustrationBadgeVisibility}"><TextBlock Text="{Binding IllustrationLabel}" Foreground="#C2410C" FontSize="11" FontWeight="SemiBold"/></Border>
                                                <Border Background="#F0FDF4" CornerRadius="10" Padding="7,3" Margin="0,0,7,0" Visibility="{Binding MetadataBadgeVisibility}"><TextBlock Text="{Binding MetadataLabel}" Foreground="#15803D" FontSize="11" FontWeight="SemiBold"/></Border>
                                                <Border Background="#F5F3FF" CornerRadius="10" Padding="7,3" Margin="0,0,7,0" Visibility="{Binding ChapterTreeBadgeVisibility}"><TextBlock Text="{Binding ChapterTreeLabel}" Foreground="#7C3AED" FontSize="11" FontWeight="SemiBold"/></Border>
                                                <Border Background="#EEF4FF" CornerRadius="10" Padding="7,3"><TextBlock Text="{Binding FormatLabel}" Foreground="#1D4ED8" FontSize="11" FontWeight="SemiBold"/></Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EmptyFilesHint" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="46" Height="46" CornerRadius="23" Background="#EEF4FF" HorizontalAlignment="Center"><TextBlock Text="＋" FontSize="26" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock Text="添加或拖入 TXT / EPUB 文件" Margin="0,9,0,0" FontWeight="SemiBold" Foreground="#475467" HorizontalAlignment="Center"/>
                                <TextBlock Text="支持混合选择与批量转换" Margin="0,3,0,0" FontSize="11" Foreground="#98A2B3" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="CoverDropPanel" Grid.Column="2" BorderBrush="#C7D7FE" BorderThickness="1" CornerRadius="10" Background="#F8FAFF" Padding="10" AllowDrop="True" DragOver="CoverDrop_DragOver" Drop="CoverDrop_Drop">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel><Border DockPanel.Dock="Right" Background="#EEF4FF" CornerRadius="10" Padding="7,3"><TextBlock Text="JPG / PNG / WebP" Foreground="#1D4ED8" FontSize="10"/></Border><TextBlock Text="所选小说封面" FontWeight="SemiBold" Foreground="#344054" VerticalAlignment="Center"/></DockPanel>
                            <Border Grid.Row="1" Margin="0,7" Background="White" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="7"><Grid><Image x:Name="CoverPreviewImage" Stretch="Uniform" Margin="5"/><TextBlock x:Name="CoverPlaceholderText" Text="选择一本小说后，将图片拖到这里" TextWrapping="Wrap" TextAlignment="Center" Foreground="#98A2B3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18"/></Grid></Border>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="BrowseCoverButton" Content="选择封面" Click="BrowseCover_Click" IsEnabled="False" Style="{StaticResource AccentButton}"/><Button x:Name="ClearCoverButton" Content="清除" Click="ClearCover_Click" IsEnabled="False" Margin="0"/></StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="130"/><ColumnDefinition Width="14"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                        <TextBlock Text="2  输出" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="输出目录"/><DockPanel><Button Content="浏览" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseOutput_Click"/><TextBox x:Name="OutputDirectoryText"/></DockPanel></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="输出格式"/><ComboBox x:Name="FormatCombo" SelectedIndex="0" SelectionChanged="FormatCombo_SelectionChanged"><ComboBoxItem Content="EPUB"/><ComboBoxItem Content="MOBI"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="6"><TextBlock Style="{StaticResource FieldLabel}" Text="并发任务"/><ComboBox x:Name="ParallelismCombo" SelectedIndex="0"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/></ComboBox></StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="预设" VerticalAlignment="Center" Foreground="#667085" Margin="0,0,7,0"/>
                            <ComboBox x:Name="PresetCombo" ItemsSource="{Binding ConversionPresets}" DisplayMemberPath="Name" Width="135" ToolTip="选择命名预设"/>
                            <TextBlock Text="名称" VerticalAlignment="Center" Foreground="#667085" Margin="9,0,7,0"/>
                            <TextBox x:Name="PresetNameText" Width="110" Margin="0,0,8,0" ToolTip="输入要保存的预设名称"/>
                            <Button Content="应用" Click="ApplyPreset_Click"/>
                            <Button Content="保存预设" Click="SavePreset_Click"/>
                            <Button Content="删除" Click="DeletePreset_Click" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="3  转换选项" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TabControl x:Name="OptionsTabs" Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0">
                        <TabItem Header="章节">
                            <Border Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="180"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="章节标题正则（留空使用原版默认）"/><TextBox x:Name="ChapterRegexText"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="文本编码"/><ComboBox x:Name="EncodingCombo" SelectedIndex="0"><ComboBoxItem Content="自动检测" Tag="Auto"/><ComboBoxItem Content="UTF-8" Tag="Utf8"/><ComboBoxItem Content="GBK" Tag="Gbk"/></ComboBox></StackPanel>
                                    <Button Grid.Column="4" Content="打开章节树" Click="EditChapters_Click" VerticalAlignment="Bottom" Style="{StaticResource AccentButton}" Margin="0"/>
                                    <Grid Grid.Row="2" Grid.ColumnSpan="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><CheckBox x:Name="FullWidthIndentCheck" Content="保留原版每段两个全角空格" IsChecked="True" Margin="0,0,24,0"/><CheckBox x:Name="KeepBlankLinesCheck" Content="保留空行"/></StackPanel><TextBlock x:Name="TocHierarchyStatusText" Grid.Column="1" Text="层级目录：关闭" Foreground="#667085" VerticalAlignment="Center"/><Button Grid.Column="3" Content="层级目录设置" Click="EditTocHierarchy_Click" Style="{StaticResource GreenButton}" Margin="0"/></Grid>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="版式">
                            <Border Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="字号 %"/><TextBox x:Name="FontSizeText" Text="110"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="行高 %"/><TextBox x:Name="LineHeightText" Text="120"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="段间距 em"/><TextBox x:Name="ParagraphSpacingText" Text="0.6"/></StackPanel>
                                    <StackPanel Grid.Column="6"><TextBlock Style="{StaticResource FieldLabel}" Text="首行缩进 em"/><TextBox x:Name="IndentText" Text="0"/></StackPanel>
                                    <StackPanel Grid.Column="8"><TextBlock Style="{StaticResource FieldLabel}" Text="对齐"/><ComboBox x:Name="AlignmentCombo" SelectedIndex="0"><ComboBoxItem Content="默认" Tag="Default"/><ComboBoxItem Content="两端" Tag="Justify"/><ComboBoxItem Content="左" Tag="Left"/><ComboBoxItem Content="居中" Tag="Center"/><ComboBoxItem Content="右" Tag="Right"/></ComboBox></StackPanel>
                                    <StackPanel Grid.Row="2"><TextBlock Style="{StaticResource FieldLabel}" Text="上边距 px"/><TextBox x:Name="PageMarginTopText" Text="0"/></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="下边距 px"/><TextBox x:Name="PageMarginBottomText" Text="0"/></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="左边距 px"/><TextBox x:Name="PageMarginLeftText" Text="3"/></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="6"><TextBlock Style="{StaticResource FieldLabel}" Text="右边距 px"/><TextBox x:Name="PageMarginRightText" Text="3"/></StackPanel>
                                    <TextBlock Grid.Row="2" Grid.Column="8" Text="页边距沿用原版配置，可在此覆盖" Foreground="#667085" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="字体">
                            <Border Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <CheckBox x:Name="EmbedFontCheck" Content="嵌入字体" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="TTF 字体文件"/><DockPanel><Button Content="选择" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseFont_Click"/><TextBox x:Name="FontPathText" IsReadOnly="True"/></DockPanel></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="字体名称（可选）"/><TextBox x:Name="FontFamilyText"/></StackPanel>
                                    <Button Grid.Column="6" Content="清除" Click="ClearFont_Click" VerticalAlignment="Bottom" Margin="0"/>
                                    <CheckBox x:Name="SubsetFontCheck" Grid.Row="2" Grid.ColumnSpan="2" Content="仅保留本书用到的字形（推荐）" IsChecked="True"/>
                                    <TextBlock x:Name="FontStatusText" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="5" Text="未选择字体。会在转换前检查字体许可与格式。" Foreground="#667085" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="书籍信息">
                            <Border Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="36"/><RowDefinition Height="6"/><RowDefinition Height="36"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <StackPanel Grid.ColumnSpan="5"><TextBlock Style="{StaticResource FieldLabel}" Text="统一作者（逐书作者为空时使用）"/><TextBox x:Name="AuthorText"/></StackPanel>
                                    <Button Grid.Column="6" Content="批量编辑逐书信息" Click="EditMetadata_Click" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" Margin="0"/>

                                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="译者" VerticalAlignment="Center" Foreground="#475467" FontWeight="SemiBold"/><TextBox x:Name="TranslatorText" Grid.Column="2"/></Grid>
                                    <Grid Grid.Row="2" Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="ISBN" VerticalAlignment="Center" Foreground="#475467" FontWeight="SemiBold"/><TextBox x:Name="IsbnText" Grid.Column="2"/></Grid>
                                    <Grid Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="出版日期" VerticalAlignment="Center" Foreground="#475467" FontWeight="SemiBold"/><DatePicker x:Name="PublicationDatePicker" Grid.Column="2" SelectedDateFormat="Short" MinHeight="36"/></Grid>

                                    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="出版社" VerticalAlignment="Center" Foreground="#475467" FontWeight="SemiBold"/><TextBox x:Name="PublisherText" Grid.Column="2"/></Grid>
                                    <Grid Grid.Row="4" Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="类别" VerticalAlignment="Center" Foreground="#475467" FontWeight="SemiBold"/><ComboBox x:Name="CategoryCombo" Grid.Column="2" IsEditable="True"><ComboBoxItem Content="小说"/><ComboBoxItem Content="文学"/><ComboBoxItem Content="科幻"/><ComboBoxItem Content="奇幻"/><ComboBoxItem Content="悬疑"/><ComboBoxItem Content="历史"/><ComboBoxItem Content="传记"/><ComboBoxItem Content="社科"/><ComboBoxItem Content="技术"/><ComboBoxItem Content="其他"/></ComboBox></Grid>
                                    <Grid Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="语言" VerticalAlignment="Center" Foreground="#475467" FontWeight="SemiBold"/><ComboBox x:Name="LanguageCombo" Grid.Column="2" IsEditable="True" Text="zh-CN"><ComboBoxItem Content="zh-CN"/><ComboBoxItem Content="zh-TW"/><ComboBoxItem Content="en"/><ComboBoxItem Content="ja"/><ComboBoxItem Content="ko"/></ComboBox></Grid>

                                    <Grid Grid.Row="6" Grid.ColumnSpan="7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="简介" VerticalAlignment="Top" Margin="0,8,0,0" Foreground="#475467" FontWeight="SemiBold"/><TextBox x:Name="DescriptionText" Grid.Column="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/><StackPanel Grid.Column="4" VerticalAlignment="Bottom"><TextBlock x:Name="MetadataMappingStatusText" Text="尚未设置文件夹映射" Foreground="#667085" FontSize="11" TextAlignment="Right" Margin="0,0,0,5"/><Button Content="文件夹元数据映射" Click="EditMetadataMappings_Click" Style="{StaticResource GreenButton}" Margin="0"/></StackPanel></Grid>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="定制 CSS">
                            <Border Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="追加在原版样式之后，可覆盖正文、标题、目录与插图样式。" Foreground="#475467"/><TextBlock x:Name="CssSummaryText" Margin="0,10,0,0" Text="未设置" Foreground="#667085" TextTrimming="CharacterEllipsis" ToolTip="直接编辑 CSS，或从 .css 文件导入"/></StackPanel>
                                    <Button Grid.Column="2" Content="编辑 / 导入 CSS" Click="EditCss_Click" VerticalAlignment="Center" Style="{StaticResource AccentButton}" Margin="0"/>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="插图">
                            <Border Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock x:Name="SelectedBookOptionsText" Text="请先在上方选择一本小说" FontWeight="SemiBold" Foreground="#344054"/><TextBlock Margin="0,8,0,0" Text="每本小说单独保存插图；可在 TXT 预览中直接选择插入位置，也保留 [[插图:标记]] 手动方式。" Foreground="#667085" TextWrapping="Wrap"/></StackPanel>
                                    <Button Grid.Column="2" Content="管理所选小说插图" Click="EditIllustrations_Click" VerticalAlignment="Center" Style="{StaticResource AccentButton}" Margin="0"/>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="MOBI 选项">
                            <Border Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="kindlegen_v2.9.exe"/><DockPanel><Button Content="选择" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseKindleGen_Click"/><TextBox x:Name="KindleGenText"/></DockPanel></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="压缩级别"/><ComboBox x:Name="CompressionCombo" SelectedIndex="1"><ComboBoxItem Content="0 - 无" Tag="0"/><ComboBoxItem Content="1 - 标准" Tag="1"/><ComboBoxItem Content="2 - 高" Tag="2"/></ComboBox></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="额外 KindleGen 参数"/><TextBox x:Name="KindleGenArgsText"/></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"><CheckBox x:Name="StripSourceCheck" IsChecked="True" Content="移除附加源文件" Margin="0,0,20,0"/><CheckBox x:Name="MobiSyncCheck" IsChecked="True" Content="写入 ASIN/EBOK"/></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="固定 ASIN（可选）"/><TextBox x:Name="MobiAsinText" MaxLength="10"/></StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"><TextBlock Style="{StaticResource FieldLabel}" Text="EPUB 输入转换方式"/><ComboBox x:Name="EpubModeCombo" SelectedIndex="0"><ComboBoxItem Content="保留原 EPUB 版式（CSS、图片、目录原样交给 KindleGen）" Tag="PreserveOriginal"/><ComboBoxItem Content="EasyPub 兼容重排（套用本页之外的新版排版选项）" Tag="EasyPubCompatible"/></ComboBox></StackPanel>
                                    <TextBlock Grid.Row="4" Grid.Column="4" Text="此选项只影响 EPUB→MOBI。保留原版式时，EasyPub 的版式、封面、字体和自定义 CSS 设置不会覆盖原 EPUB。" Foreground="#667085" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="高级">
                            <Border Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="原版 EasyPub config.xml" FontWeight="SemiBold" Foreground="#344054"/><Border Background="#ECFDF3" CornerRadius="9" Padding="6,2" Margin="8,0,0,0"><TextBlock Text="兼容模式" Foreground="#067647" FontSize="10"/></Border></StackPanel><TextBlock x:Name="LegacyConfigStatusText" Margin="0,8,12,0" Text="正在查找原版配置…" Foreground="#667085" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    <Button Grid.Column="1" Content="选择配置" Click="BrowseLegacyConfig_Click" VerticalAlignment="Center"/>
                                    <Button x:Name="ClearLegacyConfigButton" Grid.Column="2" Content="取消选择" Click="ClearLegacyConfig_Click" VerticalAlignment="Center"/>
                                    <Button x:Name="ShowLegacyConfigDetailsButton" Grid.Column="3" Content="查看映射" Click="ShowLegacyConfigDetails_Click" VerticalAlignment="Center" Margin="0"/>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>

                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="12,9" VerticalAlignment="Center"><StackPanel><ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="StatusText" Margin="0,6,0,0" Text="准备就绪，可添加或拖入多个 TXT / EPUB 文件" Foreground="#667085"/></StackPanel></Border>
                    <Button x:Name="RetryFailedButton" Grid.Column="1" Content="重试失败项" Margin="14,0,0,0" Click="RetryFailed_Click" IsEnabled="False"/>
                    <Button Grid.Column="2" Content="转换前检查" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Click="RunPreflight_Click"/>
                    <Button x:Name="CancelButton" Grid.Column="3" Content="取消" Margin="8,0,0,0" Click="Cancel_Click" IsEnabled="False"/>
                    <Button x:Name="ConvertButton" Grid.Column="4" Content="开始批量转换  →" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="Convert_Click" IsEnabled="False"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
