                                <Style.Triggers><Trigger Property="Content" Value="批量编辑"><Setter Property="Width" Value="120"/><Setter Property="HorizontalAlignment" Value="Right"/></Trigger></Style.Triggers>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="封面" FontSize="17" FontWeight="SemiBold"/><StackPanel Grid.Row="1" VerticalAlignment="Center"><Border Width="180" Height="250" Background="{DynamicResource SelectedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" ClipToBounds="True"><Grid><TextBlock Text="拖入 JPG、PNG、WebP&#x0a;或点击选择封面" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/><Image Source="{Binding ElementName=FilesList, Path=SelectedItem.CoverThumbnail}" Stretch="UniformToFill"/></Grid></Border><TextBlock x:Name="CoverDiagnosticsText" Text="JPG / PNG / WebP" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="BrowseCoverButton" Content="▧  选择封面" Click="BrowseCover_Click" IsEnabled="False"/><Button x:Name="ClearCoverButton" Grid.Column="2" Content="♲  清除" Click="ClearCover_Click" IsEnabled="False"/></Grid></Grid></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="书籍信息" FontSize="17" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="批量编辑" Click="EditMetadata_Click" Padding="13,6" MinHeight="32"/></DockPanel><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="作者" VerticalAlignment="Center"/><TextBox x:Name="AuthorText" Grid.Column="1" TextChanged="SelectedMetadataField_Changed"/><TextBlock Grid.Column="3" Text="译者" VerticalAlignment="Center"/><TextBox x:Name="TranslatorText" Grid.Column="4" TextChanged="SelectedMetadataField_Changed"/></Grid><Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="出版社" VerticalAlignment="Center"/><TextBox x:Name="PublisherText" AutomationProperties.AutomationId="PublisherText" Grid.Column="1" TextChanged="SelectedMetadataField_Changed"/><TextBlock Grid.Column="3" Text="ISBN" VerticalAlignment="Center"/><TextBox x:Name="IsbnText" Grid.Column="4" TextChanged="SelectedMetadataField_Changed"/></Grid><Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="出版日期" VerticalAlignment="Center"/><DatePicke