<Window x:Class="EasyPub.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyPub Modern v1.1.1" Width="1440" Height="900" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}" AllowDrop="True"
        FontFamily="Microsoft YaHei UI" TextOptions.TextFormattingMode="Display"
        Drop="Window_Drop" DragOver="Window_DragOver" SizeChanged="MainWindow_SizeChanged" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#171716"/>
        <SolidColorBrush x:Key="TextBrush" Color="#171716"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#77736C"/>
        <SolidColorBrush x:Key="LineBrush" Color="#DEDAD2"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/><Setter Property="MinHeight" Value="40"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="ButtonIcon" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons" FontWeight="Normal" Margin="0,0,8,0" VerticalAlignment="Center"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border>
                <ControlTemplate.Triggers><Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="ButtonIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="ButtonIcon" Property="Margin" Value="0"/></Trigger><Trigger Property="Tag" Value=""><Setter TargetName="ButtonIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="ButtonIcon" Property="Margin" Value="0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryActionTextBrush}"/><Setter Property="Padding" Value="25,12"/><Setter Property="MinHeight" Value="48"/></Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/></Style>
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="11,8"/><Setter Property="MinHeight" Value="40"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="40"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/></Style>
        <Style x:Key="SidebarNavigation" TargetType="RadioButton">
            <Setter Property="Height" Value="58"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="18,0"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="NavigationBorder" Padding="{TemplateBinding Padding}" CornerRadius="9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><StackPanel Orientation="Horizontal"><TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons" FontWeight="Normal" Width="28" VerticalAlignment="Center"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource SubtleSurfaceBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/><Setter TargetName="NavigationBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="BookRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityName}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RowBorder" Padding="13,9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleSurfaceBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MiniNav" TargetType="RadioButton"><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="12,0"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="B" Padding="{TemplateBinding Padding}" CornerRadius="7" Background="Transparent"><StackPanel Orientation="Horizontal"><TextBlock x:Name="MiniIcon" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons" Width="25" VerticalAlignment="Center"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="MiniIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="MiniIcon" Property="Width" Value="0"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleSurfaceBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>

    <Grid x:Name="RootLayout" Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="72"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="HeaderLogo" Width="58" Height="58" Source="/Assets/EasyPubModern.png" Stretch="Uniform"/><StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="HeaderTitleText" Text="EasyPub Modern" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock x:Name="HeaderSubtitleText" Margin="0,4,0,0" Text="TXT / EPUB 到 Kindle · 章节树、封面、正文插图与定制排版" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0"><Button x:Name="ProjectMenuButton" Content="当前项目：网文整理  ⌄" Click="ProjectMenu_Click" HorizontalContentAlignment="Left" Padding="13,8" ToolTip="新建、打开、保存或另存项目"/><TextBlock x:Name="WorkspaceScopeText" Margin="7,5,0,0" Text="✓  已保存" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/></StackPanel>
            <Grid Grid.Column="2" Margin="10,15"><TextBox x:Name="BookSearchText" Padding="42,8,65,8" TextChanged="BookWorklistFilter_Changed" ToolTip="按书名或路径搜索" AutomationProperties.Name="搜索书稿"/><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="19" Margin="14,0,0,1" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Text="Ctrl+F" Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False"/></Grid>
            <Border Grid.Column="3" Margin="10,15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="LightThemeButton" Content="浅色" Tag="&#xE706;" Click="UseLightTheme_Click" Background="Transparent" BorderThickness="0" Padding="8"/><Button x:Name="DarkThemeButton" Grid.Column="1" Content="深色" Tag="&#xE708;" Click="UseDarkTheme_Click" Background="Transparent" BorderThickness="0" Padding="8"/></Grid></Border>
            <Button x:Name="SettingsButton" Grid.Column="4" Content="设置" Tag="&#xE713;" Click="ShowSettings_Click" Margin="8,15,0,15" AutomationProperties.Name="打开全局设置"/>
            <Button x:Name="PreviewBookButton" Visibility="Collapsed" Content="成品预览" Click="PreviewBook_Click" IsEnabled="False"/><Button x:Name="TaskCenterButton" Visibility="Collapsed" Content="任务中心" Click="ShowTaskCenter_Click"/><StackPanel x:Name="HeaderActionsPanel" Visibility="Collapsed"/>
        </Grid>
        <Border x:Name="RecoveryBanner" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="9" Padding="12,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="RecoveryBannerText" TextWrapping="Wrap" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="恢复" Click="RestoreRecovery_Click"/><Button Content="暂不恢复" Click="IgnoreRecovery_Click" Margin="8,0"/><Button Content="删除快照" Click="DeleteRecovery_Click"/></StackPanel></Grid></Border>

        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="200"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="SidebarPanel" Style="{StaticResource Card}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="制作流程" Margin="8,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/><StackPanel Grid.Row="2"><RadioButton x:Name="LibraryNavigationButton" GroupName="MainNavigation" IsChecked="True" Content="书库" Tag="&#xE8F1;" Style="{StaticResource SidebarNavigation}" Click="NavigateLibrary_Click" AutomationProperties.Name="书库：导入与管理书稿"/><RadioButton x:Name="ChaptersNavigationButton" GroupName="MainNavigation" Content="章节正文" Tag="&#xE8A5;" Style="{StaticResource SidebarNavigation}" Click="NavigateChapters_Click" AutomationProperties.Name="章节正文：章节树与文本清理"/><RadioButton x:Name="CoverNavigationButton" GroupName="MainNavigation" Content="封面信息" Tag="&#xEB9F;" Style="{StaticResource SidebarNavigation}" Click="NavigateCover_Click" AutomationProperties.Name="封面信息：逐书封面与元数据"/><RadioButton x:Name="LayoutNavigationButton" GroupName="MainNavigation" Content="排版插图" Tag="&#xEB9F;" Style="{StaticResource SidebarNavigation}" Click="NavigateLayout_Click" AutomationProperties.Name="排版插图：版式字体 CSS 与插图"/><RadioButton x:Name="ConvertNavigationButton" GroupName="MainNavigation" Content="转换输出" Tag="&#xE898;" Style="{StaticResource SidebarNavigation}" Click="NavigateConvert_Click" AutomationProperties.Name="转换输出：目标格式、引擎与开始转换"/><RadioButton x:Name="TasksNavigationButton" GroupName="MainNavigation" Content="任务中心" Tag="&#xE9D5;" Style="{StaticResource SidebarNavigation}" Click="NavigateTasks_Click" AutomationProperties.Name="任务中心：进度、验收与历史"/></StackPanel><StackPanel Grid.Row="3"><Button x:Name="ShortcutManagerButton" Content="快捷键管理" Tag="&#xE765;" Click="ManageShortcuts_Click" HorizontalContentAlignment="Left" Padding="10,7" MinHeight="34" AutomationProperties.Name="打开快捷键管理"/><TextBlock Text="v1.1.1" Margin="8,8,0,4" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel></Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock x:Name="PageTitleText" Text="书库" Style="{StaticResource SectionTitle}"/><Border x:Name="FileCountBadge" Margin="10,3,0,0" Background="{DynamicResource SelectedSurfaceBrush}" CornerRadius="12" Padding="9,3"><TextBlock x:Name="FileCountText" Text="0 本" FontSize="11"/></Border></StackPanel><TextBlock x:Name="PageSubtitleText" Text="导入、筛选并批量管理待转换书稿" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/></StackPanel>
                    <StackPanel x:Name="LibraryToolbarPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Button x:Name="AddBooksButton" Content="添加书稿" Tag="&#xE710;" Click="AddFiles_Click" Margin="0" AutomationProperties.Name="选择 TXT 或 EPUB 书稿"/><Menu x:Name="AddBooksMenu" Margin="2,0,8,0" VerticalAlignment="Center" Background="Transparent"><MenuItem Padding="10,9" AutomationProperties.Name="添加书稿菜单"><MenuItem.Header><TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons"/></MenuItem.Header><MenuItem Header="选择 TXT / EPUB 文件…" Click="AddFiles_Click"/><MenuItem Header="导入整个文件夹…" Click="ImportFolder_Click"/></MenuItem></Menu></StackPanel><Button Content="导入文件夹" Tag="&#xE8B7;" Click="ImportFolder_Click"/><Menu x:Name="FavoriteImportMenu" Margin="8,0,0,0" VerticalAlignment="Center" Background="Transparent"><MenuItem Padding="12,9" AutomationProperties.Name="从收藏文件夹导入"><MenuItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0"/><TextBlock Text="从收藏导入"/></StackPanel></MenuItem.Header><MenuItem x:Name="FavoriteFoldersMenu" Header="选择收藏文件夹" ItemsSource="{Binding FavoriteFolders}"><MenuItem.ItemContainerStyle><Style TargetType="MenuItem"><Setter Property="Header" Value="{Binding}"/><EventSetter Event="Click" Handler="FavoriteFolderMenuItem_Click"/></Style></MenuItem.ItemContainerStyle></MenuItem><Separator/><MenuItem Header="添加收藏文件夹…" Click="AddFavoriteFolder_Click"/><MenuItem Header="管理收藏文件夹…" Click="ManageFavoriteFolders_Click"/></MenuItem></Menu><Button x:Name="RemoveSelectedButton" Content="移除所选" Tag="&#xE74D;" Click="RemoveSelected_Click" IsEnabled="False" Margin="8,0"/><Button x:Name="MoreLibraryActionsButton" Content="更多" Tag="&#xE70D;" Click="MoreLibraryActions_Click"/><Button x:Name="SelectAllFilesButton" Visibility="Collapsed" Content="全选" Click="SelectAllFiles_Click" IsEnabled="False"/><Button x:Name="ClearFilesButton" Visibility="Collapsed" Content="清空" Click="ClearFiles_Click" IsEnabled="False"/></StackPanel>
                </Grid><Border Grid.Row="1" Background="{DynamicResource BorderBrush}"/>
                <ScrollViewer x:Name="MainContentScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="MainContentGrid">
                    <Grid x:Name="InkLibraryPage"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="CoverGapColumn" Width="12"/><ColumnDefinition x:Name="CoverColumn" Width="320"/></Grid.ColumnDefinitions>
                        <Border x:Name="BookListSection" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderBrush}"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions><Grid Background="{DynamicResource SubtleSurfaceBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="120"/><ColumnDefinition Width="125"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><CheckBox Margin="15,0,0,0" VerticalAlignment="Center" ToolTip="使用 Ctrl+A 全选"/><TextBlock Grid.Column="1" Text="书名 / 路径" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Grid.Column="2" Text="格式" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Grid.Column="3" Text="状态" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Grid.Column="4" Text="来源" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Grid.Column="5" Text="操作" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/></Grid>
                            <ListBox x:Name="FilesList" Grid.Row="1" ItemsSource="{Binding InputBooks}" SelectionMode="Extended" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource BookRow}" SelectionChanged="FilesList_SelectionChanged" PreviewMouseLeftButtonDown="FilesList_PreviewMouseLeftButtonDown" PreviewMouseMove="FilesList_PreviewMouseMove" PreviewMouseLeftButtonUp="FilesList_PreviewMouseLeftButtonUp" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="待转换书稿列表"><ListBox.ItemTemplate><DataTemplate><Grid Height="60"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="120"/><ColumnDefinition Width="125"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><Border Width="40" Height="52" CornerRadius="4" Background="{DynamicResource SelectedSurfaceBrush}" ClipToBounds="True"><Grid><TextBlock Text="文" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/><Image Source="{Binding CoverThumbnail}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" Margin="12,3,10,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DirectoryPath}" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding FormatLabel}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding ReadinessLabel}" Foreground="{Binding ReadinessForeground}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding MetadataLabel}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/><Button Grid.Column="5" Content="•••" Padding="5" MinHeight="30" Background="Transparent" BorderThickness="0" Click="BookActions_Click" AutomationProperties.Name="书稿操作"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                            <StackPanel x:Name="EmptyFilesHint" Grid.Row="1" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="＋" FontSize="32" HorizontalAlignment="Center"/><TextBlock Text="添加或拖入 TXT / EPUB 文件" Margin="0,8,0,0" FontWeight="SemiBold"/><TextBlock Text="支持混合选择与批量转换" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel><DockPanel Grid.Row="2" Margin="14,0"><TextBlock x:Name="LibrarySelectionSummaryText" Text="尚未选择书稿" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><CheckBox Content="全选本页" VerticalAlignment="Center"/><Button Content="☷" Padding="8,4" MinHeight="28" Margin="12,0,4,0"/><Button Content="▦" Padding="8,4" MinHeight="28"/></StackPanel></DockPanel>
                        </Grid></Border>
                        <Border x:Name="CoverDropPanel" Grid.Column="2" Padding="20" AllowDrop="True" DragOver="CoverDrop_DragOver" Drop="CoverDrop_Drop" AutomationProperties.Name="所选小说概览与封面"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="所选书稿" FontSize="16" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="⌃"/></DockPanel><StackPanel Grid.Row="1" VerticalAlignment="Center"><Button x:Name="OpenCoverPreviewButton" Click="OpenCoverPreview_Click" IsEnabled="False" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,12"><Border x:Name="CoverPreviewBorder" Width="132" Height="184" Background="{DynamicResource SelectedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" ClipToBounds="True"><Grid><Image x:Name="CoverPreviewImage" Stretch="UniformToFill" Margin="3"/><TextBlock x:Name="CoverPlaceholderText" Text="暂无封面&#x0a;点击选择" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/></Grid></Border></Button><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectedBookNameText" Text="请先选择一本书稿" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><Border Grid.Column="1" Height="24" MinWidth="42" VerticalAlignment="Top" Margin="8,0,0,0" Background="{DynamicResource SelectedSurfaceBrush}" CornerRadius="8" Padding="8,0"><TextBlock x:Name="SelectedBookFormatText" Text="TXT" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></Grid><TextBlock x:Name="SelectedBookSummaryText" Margin="0,7,0,0" Text="封面：无 · 元数据：无 · 插图：0 · 章节树：无" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><Separator Margin="0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="路径" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding ElementName=FilesList, Path=SelectedItem.DirectoryPath}" TextWrapping="Wrap"/></Grid></StackPanel><StackPanel Grid.Row="2"><Button x:Name="QuickChapterButton" Content="▤  编辑章节正文      ›" Click="EditChapters_Click" HorizontalContentAlignment="Left"/><Button x:Name="QuickMetadataButton" Content="▧  编辑封面信息      ›" Click="NavigateCover_Click" HorizontalContentAlignment="Left" Margin="0,8,0,0"/><WrapPanel Visibility="Collapsed"><Button x:Name="QuickCleanupButton" Content="文本清理" Click="EditTextCleanup_Click"/><Button x:Name="QuickIllustrationButton" Content="插图" Click="EditIllustrations_Click"/><Button x:Name="QuickPreviewButton" Content="预览" Click="PreviewBook_Click"/></WrapPanel></StackPanel></Grid></Border>
                    </Grid>

                    <Grid x:Name="InkChaptersPage" Visibility="Collapsed" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="章节树" FontSize="16" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" x:Name="TocHierarchyStatusText" Text="未设置" Foreground="{DynamicResource SecondaryTextBrush}"/></DockPanel><WrapPanel Grid.Row="1" Margin="0,12,0,10"><Button Content="打开章节工作台" Click="EditChapters_Click"/><Button Content="文本清理" Click="EditTextCleanup_Click" Margin="8,0,0,0"/></WrapPanel><Border Grid.Row="2" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="7" Padding="14"><TextBlock x:Name="ChapterTreeSummaryText" Text="选择一本 TXT 后，可识别卷、章和前置章节。&#x0a;&#x0a;章节层级与目录勾选会保存在项目中，不修改原始 TXT。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/></Border><TextBlock x:Name="TextCleanupStatusText" Grid.Row="3" Margin="0,10,0,0" Text="使用原文，不做额外清理" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/></Grid></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="正文定位预览" FontSize="16" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="文本清理与规则" Click="EditTextCleanup_Click" Padding="12,5" MinHeight="30"/></DockPanel><TextBox Grid.Row="1" Margin="0,12,0,10" Text="选择清理结果后可逐处定位到正文" IsReadOnly="True" Foreground="{DynamicResource SecondaryTextBrush}"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ChapterPreviewText" Text="请先在书库选择一本 TXT 书稿。" FontSize="14" LineHeight="30" TextWrapping="Wrap"/></ScrollViewer><TextBlock Grid.Row="3" x:Name="ChapterPreviewStatsText" Text="0 行 / 0 字" Margin="0,10,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></Grid></Border>
