<Window x:Class="EasyPub.Desktop.ShortcutManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="快捷键管理 · EasyPub Modern" Width="760" Height="650" MinWidth="640" MinHeight="500" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="快捷键管理" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="双击“快捷键”单元格后输入，例如 Ctrl+O。冲突或无效组合会在保存前提示。" Margin="0,6,0,18" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="ShortcutGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="类别" Binding="{Binding Category}" IsReadOnly="True" Width="120"/><DataGridTextColumn Header="操作" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="快捷键" Binding="{Binding Gesture, UpdateSourceTrigger=PropertyChanged}" Width="180"/></DataGrid.Columns></DataGrid></Border>
        <DockPanel Grid.Row="2" Margin="0,18,0,0"><Button Content="恢复默认" Click="Reset_Click" HorizontalAlignment="Left"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="取消" Click="Cancel_Click"/><Button Content="保存快捷键" Click="Save_Click" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}"/></StackPanel></DockPanel>
    </Grid>
</Window>
