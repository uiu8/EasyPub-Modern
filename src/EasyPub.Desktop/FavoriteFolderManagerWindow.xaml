<Window x:Class="EasyPub.Desktop.FavoriteFolderManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="收藏文件夹 · EasyPub Modern" Width="760" Height="480" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="收藏文件夹" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="收藏项会出现在“添加书稿”下拉菜单中；删除收藏不会删除原文件夹。" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8">
            <ListBox x:Name="FoldersList" ItemsSource="{Binding Folders}" BorderThickness="0" Background="Transparent" SelectionChanged="FoldersList_SelectionChanged">
                <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="10,8"><TextBlock Text="☆" Margin="0,0,10,0"/><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <DockPanel Grid.Row="4">
            <StackPanel Orientation="Horizontal"><Button Content="＋ 添加收藏" Click="Add_Click"/><Button x:Name="RemoveButton" Content="移除所选" Click="Remove_Click" IsEnabled="False"/></StackPanel>
            <Button Content="完成" DockPanel.Dock="Right" Click="Done_Click" Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}" BorderBrush="{DynamicResource PrimaryActionBrush}" Margin="0"/>
        </DockPanel>
    </Grid>
</Window>
