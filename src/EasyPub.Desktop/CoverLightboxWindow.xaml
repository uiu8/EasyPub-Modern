<Window x:Class="EasyPub.Desktop.CoverLightboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="封面预览 · EasyPub Modern v1.1.2" Width="620" Height="760" MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" FontFamily="Microsoft YaHei UI"
        AutomationProperties.Name="封面大图预览">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <Border DockPanel.Dock="Right" Background="{DynamicResource InfoSurfaceBrush}" CornerRadius="12" Padding="9,4"><TextBlock Text="原图比例" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/></Border>
            <StackPanel>
                    <TextBlock Text="封面预览" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="BookNameText" Margin="0,4,12,0" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="2" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
        <Border Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" HorizontalAlignment="Center">
                <Image x:Name="CoverImage" Stretch="Uniform" MaxWidth="500" MaxHeight="610"/>
            </Border>
        </Border>
        <DockPanel Grid.Row="4">
            <TextBlock x:Name="CoverInfoText" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="450"/>
            <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True" Padding="22,8"/>
        </DockPanel>
    </Grid>
</Window>
