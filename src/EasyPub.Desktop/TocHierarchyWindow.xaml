<Window x:Class="EasyPub.Desktop.TocHierarchyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="层级目录设置 · EasyPub Modern v0.15.0" Width="820" Height="560" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#F5F7FB" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="9,6"/><Setter Property="MinHeight" Value="36"/><Setter Property="BorderBrush" Value="#D0D7E2"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D0D7E2"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#344054"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="层级目录设置" FontSize="25" FontWeight="SemiBold" Foreground="#172033"/>
            <TextBlock Text="按标题格式识别卷、章、节，并生成 Kindle 可折叠的嵌套目录。" Margin="0,4,0,0" Foreground="#667085"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#ECFDF3" BorderBrush="#A7E3C1" BorderThickness="1" CornerRadius="10" Padding="12">
            <CheckBox x:Name="EnableCheck" Content="启用三级层级目录" FontWeight="SemiBold" Foreground="#067647"/>
        </Border>
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" IsEnabled="{Binding ElementName=EnableCheck, Path=IsChecked}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Style="{StaticResource Label}" Text="一级目录正则（通常为卷、部、篇、集）"/><TextBox x:Name="Level1PatternText" FontFamily="Consolas"/><TextBlock Text="示例：第一卷 风起" Foreground="#98A2B3" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="2"><TextBlock Style="{StaticResource Label}" Text="二级目录正则（通常为章、回）"/><TextBox x:Name="Level2PatternText" FontFamily="Consolas"/><TextBlock Text="示例：第一章 雨夜" Foreground="#98A2B3" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="4"><TextBlock Style="{StaticResource Label}" Text="三级目录正则（通常为节）"/><TextBox x:Name="Level3PatternText" FontFamily="Consolas"/><TextBlock Text="示例：第一节 来客" Foreground="#98A2B3" Margin="0,4,0,0"/></StackPanel>
                <Border Grid.Row="6" Background="#EEF4FF" CornerRadius="8" Padding="10"><TextBlock Text="标题同时匹配多条规则时，优先采用更高层级。未匹配这些规则但符合普通章节正则的标题，按二级目录处理。" Foreground="#1D4ED8" TextWrapping="Wrap"/></Border>
            </Grid>
        </Border>
        <Grid Grid.Row="6">
            <Button Content="恢复默认规则" Click="ResetDefaults_Click" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="Cancel_Click"/>
                <Button Content="保存设置" Click="Save_Click" Margin="0" Background="#2563EB" Foreground="White" BorderBrush="#2563EB"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
