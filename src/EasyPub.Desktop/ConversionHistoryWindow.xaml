<Window x:Class="EasyPub.Desktop.ConversionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="转换历史 · EasyPub Modern v1.1.1" Width="980" Height="600" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" FontFamily="Microsoft YaHei UI">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="转换历史" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="保留最近 500 条记录；可选择失败项并载入主窗口重新转换。" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
        <Border Grid.Row="2" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="135"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="70"/>
                    <DataGridTextColumn Header="书稿" Binding="{Binding FileName}" Width="170"/>
                    <DataGridTextColumn Header="输出" Binding="{Binding OutputName}" Width="150"/>
                    <DataGridTextColumn Header="章节" Binding="{Binding ChapterText}" Width="65"/>
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="80"/>
                    <DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="关闭" Padding="18,8" Margin="0,0,8,0" Click="Close_Click"/>
            <Button Content="载入选中/全部失败项" Padding="20,8" Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}" BorderBrush="{DynamicResource PrimaryActionBrush}" Click="Retry_Click"/>
        </StackPanel>
    </Grid>
</Window>
