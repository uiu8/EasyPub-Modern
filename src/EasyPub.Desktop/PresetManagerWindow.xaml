<Window x:Class="EasyPub.Desktop.PresetManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理转换方案 · EasyPub Modern" Width="620" Height="460" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" FontFamily="Microsoft YaHei UI">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="管理转换方案" FontSize="23" FontWeight="SemiBold"/><TextBlock Margin="0,4,0,0" Text="转换方案只保存整批通用参数，不包含书稿、逐书封面、章节树、插图或逐书元数据。" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
        <Border Grid.Row="2" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="PresetList" DisplayMemberPath="Name" SelectionChanged="PresetList_SelectionChanged"/>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="NameText" MinHeight="36" Padding="8" VerticalContentAlignment="Center" ToolTip="输入转换方案名称"/>
                    <Button Grid.Column="2" Content="另存当前批次" Padding="14,8" Margin="0,0,8,0" Click="Save_Click"/>
                    <Button x:Name="ApplyButton" Grid.Column="3" Content="应用所选" Padding="14,8" Margin="0,0,8,0" Click="Apply_Click" IsEnabled="False"/>
                    <Button Grid.Column="4" Content="删除所选" Padding="14,8" Click="Delete_Click"/>
                </Grid>
            </Grid>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="完成" Padding="20,8" Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}" BorderBrush="{DynamicResource PrimaryActionBrush}" Click="Done_Click"/></StackPanel>
    </Grid>
</Window>
