<UserControl x:Class="EasyPub.Desktop.ConversionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="500">
    <UserControl.Resources>
        <Style x:Key="CategoryTab" TargetType="TabItem">
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" CornerRadius="9" Background="Transparent">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SubtleSurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="ApplyButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryActionTextBrush}"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ChoiceRadio" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="74"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="ChoiceDot" Width="17" Height="17" CornerRadius="9" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,2,0,0"><Ellipse x:Name="ChoiceDotFill" Width="9" Height="9" Fill="{DynamicResource PrimaryActionBrush}" Visibility="Collapsed"/></Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}"/><Setter TargetName="ChoiceBorder" Property="BorderThickness" Value="1.5"/><Setter TargetName="ChoiceDotFill" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource SubtleSurfaceBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="SwitchTrack" Grid.Column="1" Width="40" Height="22" CornerRadius="11" Background="#B8BDC2" HorizontalAlignment="Right">
                                <Ellipse x:Name="SwitchThumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource PrimaryActionBrush}"/><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="转换设置" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ScopeSummaryText" Text="本批次设置与默认值" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <Button x:Name="CloseSettingsButton" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" Click="Cancel_Click" Padding="12,7" FontSize="20" ToolTip="关闭转换设置"/>
            </Grid>
        </Border>

        <TabControl x:Name="CategoryTabs" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0"
                    ItemContainerStyle="{StaticResource CategoryTab}" Padding="12">
            <TabItem Header="基本输出">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,8,20,16">
                        <TextBlock Text="基本输出" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="设置格式、目录与可复用排版方案" Style="{StaticResource HelpText}" Margin="0,5,0,18"/>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="输出格式" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="OutputFormatCombo" Visibility="Collapsed" SelectionChanged="OutputFormatCombo_SelectionChanged">
                                    <ComboBoxItem Content="EPUB" Tag="epub"/>
                                    <ComboBoxItem Content="MOBI（Kindle）" Tag="mobi"/>
                                </ComboBox>
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="EpubOutputRadio" GroupName="OutputFormat" Tag="epub" Style="{StaticResource ChoiceRadio}" Click="OutputFormatRadio_Click">
                                        <StackPanel><TextBlock Text="EPUB" FontWeight="SemiBold"/><TextBlock Text="适合现代阅读器与 Send to Kindle" Style="{StaticResource HelpText}" Margin="0,4,0,0"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="MobiOutputRadio" GroupName="OutputFormat" Tag="mobi" Style="{StaticResource ChoiceRadio}" Margin="0" Click="OutputFormatRadio_Click">
                                        <StackPanel><TextBlock Text="MOBI（Kindle）" FontWeight="SemiBold"/><TextBlock Text="适合旧 Kindle 与 USB 传书" Style="{StaticResource HelpText}" Margin="0,4,0,0"/></StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="输出目录" Style="{StaticResource FieldLabel}"/>
                                <DockPanel>
                                    <Button Content="浏览" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseOutput_Click"/>
                                    <TextBox x:Name="OutputDirectoryText"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="排版方案" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="LayoutModeCombo">
                                        <ComboBoxItem Content="原版 EasyPub 兼容" Tag="OriginalCompatible"/>
                                        <ComboBoxItem Content="现代排版" Tag="ModernLayout"/>
                                        <ComboBoxItem Content="自定义" Tag="Custom"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="常用方案" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="PresetCombo" SelectionChanged="PresetCombo_SelectionChanged"/>
                                    <TextBlock Text="方案管理仍位于排版页" Style="{StaticResource HelpText}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="原版 EasyPub config.xml" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="LegacyConfigStatusText" Text="尚未选择" Style="{StaticResource HelpText}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="选择文件" Click="BrowseLegacyConfig_Click"/>
                                    <Button x:Name="ClearLegacyConfigButton" Content="取消选择" Click="ClearLegacyConfig_Click" Margin="8,0,0,0"/>
                                    <Button x:Name="ShowLegacyMappingButton" Content="查看映射" Click="ShowLegacyMapping_Click" Margin="8,0,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="EPUB 输入">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,8,20,16">
                        <TextBlock Text="EPUB 输入" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="设置 EPUB 转 MOBI 时的默认处理方式" Style="{StaticResource HelpText}" Margin="0,5,0,18"/>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <RadioButton x:Name="PreserveEpubRadio" GroupName="EpubMode" Content="保留原 EPUB 版式（推荐）" FontWeight="SemiBold"/>
                                <TextBlock Text="保留原书正文结构、图片和目录，适合排版已经完整的 EPUB。" Style="{StaticResource HelpText}" Margin="25,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <RadioButton x:Name="ReflowEpubRadio" GroupName="EpubMode" Content="EasyPub 兼容重排" FontWeight="SemiBold"/>
                                <TextBlock Text="读取正文后按 EasyPub 规则重新生成；固定版式 EPUB 不允许使用。" Style="{StaticResource HelpText}" Margin="25,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource InfoSurfaceBrush}" CornerRadius="8" Padding="14">
                            <TextBlock x:Name="EpubScopeText" Text="即使当前没有选择 EPUB，也可以提前保存默认值；该设置只对 EPUB 输入生效。" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="MOBI / Kindle">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,8,20,16">
                        <TextBlock Text="MOBI / Kindle" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="配置 KindleGen 与 MOBI 专用参数" Style="{StaticResource HelpText}" Margin="0,5,0,18"/>

                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="KindleGenStatusText" Text="正在检查 KindleGen…" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="KindleGenPathText" Margin="0,6,0,0" Style="{StaticResource HelpText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="程序路径属于本机设置，不随转换方案改变" Margin="0,6,0,0" Style="{StaticResource HelpText}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="前往全局设置" VerticalAlignment="Center" Margin="14,0,0,0" Click="OpenEngineSettings_Click"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="压缩级别" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CompressionCombo">
                                    <ComboBoxItem Content="无" Tag="0"/>
                                    <ComboBoxItem Content="标准（推荐）" Tag="1"/>
                                    <ComboBoxItem Content="高" Tag="2"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <CheckBox x:Name="StripSourceCheck" Content="移除附加源文件" Style="{StaticResource ToggleSwitch}"/>
                                <TextBlock Text="减小 MOBI 文件体积" Style="{StaticResource HelpText}" Margin="25,5,0,10"/>
                                <CheckBox x:Name="ReadingSyncCheck" Content="写入 ASIN / EBOK" Style="{StaticResource ToggleSwitch}" Checked="ReadingSyncCheck_Changed" Unchecked="ReadingSyncCheck_Changed"/>
                                <TextBox x:Name="AsinText" Margin="25,8,0,0" ToolTip="留空时自动生成；也可输入固定 ASIN"/>
                                <TextBlock Text="留空时自动生成；填写后会复用固定 ASIN" Style="{StaticResource HelpText}" Margin="25,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="KindleGen 额外参数（可选）" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="KindleGenArgumentsText"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="性能与文件">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,8,20,16">
                        <TextBlock Text="性能与文件" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="控制并发、文件冲突与超长小说处理" Style="{StaticResource HelpText}" Margin="0,5,0,18"/>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="并发任务" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ParallelismCombo" SelectionChanged="ParallelismCombo_SelectionChanged">
                                    <ComboBoxItem Content="自动（推荐）" Tag="0"/>
                                    <ComboBoxItem Content="1" Tag="1"/><ComboBoxItem Content="2" Tag="2"/>
                                    <ComboBoxItem Content="4" Tag="4"/><ComboBoxItem Content="8" Tag="8"/>
                                    <ComboBoxItem Content="12" Tag="12"/><ComboBoxItem Content="16" Tag="16"/>
                                    <ComboBoxItem Content="32" Tag="32"/>
                                </ComboBox>
                                <TextBlock x:Name="ParallelismHintText" Style="{StaticResource HelpText}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="同名文件处理" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CollisionPolicyCombo">
                                    <ComboBoxItem Content="自动改名（推荐）" Tag="AutoRename"/>
                                    <ComboBoxItem Content="覆盖旧文件" Tag="Overwrite"/>
                                    <ComboBoxItem Content="跳过已有文件" Tag="Skip"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <CheckBox x:Name="OptimizeLongBookCheck" Content="优化超长小说编译速度" Style="{StaticResource ToggleSwitch}"/>
                                <TextBlock Text="减少 KindleGen 处理的正文分片；仅在 MOBI 输出时生效" Style="{StaticResource HelpText}" Margin="25,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="验收与完成">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,8,20,16">
                        <TextBlock Text="验收与完成" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="设置报告与转换过程中的完成动作" Style="{StaticResource HelpText}" Margin="0,5,0,18"/>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="转换前始终检查" FontWeight="SemiBold"/>
                                <TextBlock Text="输入、章节、封面、输出路径、DRM 与 KindleGen 等硬性问题不可关闭。" Style="{StaticResource HelpText}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <CheckBox x:Name="ArtifactValidationCheck" Content="转换后执行结构验收" Style="{StaticResource ToggleSwitch}" Checked="ArtifactValidationCheck_Changed" Unchecked="ArtifactValidationCheck_Changed"/>
                                <TextBlock Text="检查目录、链接、图片、字体与关键 Kindle 字段" Style="{StaticResource HelpText}" Margin="25,6,0,12"/>
                                <DockPanel Margin="25,0,0,0">
                                    <TextBlock Text="保留最近" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ReportRetentionCombo" Width="180" Margin="14,0,0,0">
                                        <ComboBoxItem Content="5 份报告" Tag="5"/>
                                        <ComboBoxItem Content="10 份报告" Tag="10"/>
                                        <ComboBoxItem Content="20 份报告" Tag="20"/>
                                        <ComboBoxItem Content="50 份报告" Tag="50"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <CheckBox x:Name="AutoOpenOutputCheck" Content="转换完成后打开输出目录" Style="{StaticResource ToggleSwitch}"/>
                                <CheckBox x:Name="AutoOpenTaskCenterCheck" Content="转换时自动打开任务中心" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource WarningSurfaceBrush}" CornerRadius="8" Padding="14">
                            <TextBlock Text="结构验收通过不等于所有 Kindle 真机均已确认。" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="22,12">
                <Button Content="恢复默认" HorizontalAlignment="Left" Click="RestoreDefaults_Click"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="CancelSettingsButton" Content="取消" Click="Cancel_Click"/>
                    <Button x:Name="ApplySettingsButton" Content="应用设置" Style="{StaticResource ApplyButton}" Margin="10,0,0,0" Click="Apply_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
