<Window x:Class="EasyPub.Desktop.IllustrationPositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择插图位置" Width="920" Height="680" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" FontFamily="Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/>
            <RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="在 TXT 中选择插图位置" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Margin="0,4,0,0" Text="选择一行后，插图会出现在该行正文之后；原 TXT 文件不会被修改。" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="跳到章节" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0"/>
                <ComboBox x:Name="ChapterCombo" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="ChapterCombo_SelectionChanged"/>
                <TextBlock Grid.Column="3" Text="查找文字" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchText" Grid.Column="4" KeyDown="SearchText_KeyDown"/>
                <Button Grid.Column="5" Content="查找下一个" Click="FindNext_Click" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                      SelectionChanged="LinesGrid_SelectionChanged" MouseDoubleClick="LinesGrid_MouseDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChapterCandidate}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="行号" Binding="{Binding LineNumber}" Width="80"/>
                    <DataGridTextColumn Header="TXT 内容" Binding="{Binding Text}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="6" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9">
            <TextBlock x:Name="SelectedPositionText" Text="请选择一行" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
        </Border>

        <DockPanel Grid.Row="8">
            <Button Content="改用手动标记" Click="UseManualMarker_Click" Padding="15,8"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="取消" IsCancel="True" Padding="18,8" Margin="0,0,8,0"/>
                <Button Content="插入在所选行之后" IsDefault="True" Click="Confirm_Click" Padding="20,8"
                        Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}" BorderBrush="{DynamicResource PrimaryActionBrush}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
