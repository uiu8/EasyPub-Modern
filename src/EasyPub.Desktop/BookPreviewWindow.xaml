<Window x:Class="EasyPub.Desktop.BookPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="近似版式预览 · EasyPub Modern v1.1.3" Width="1120" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" FontFamily="Microsoft YaHei UI">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
        <Border DockPanel.Dock="Right" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="13" Padding="10,5"><TextBlock Text="近似预览 · 非 Kindle 真机确认" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/></Border>
            <StackPanel>
                <TextBlock Text="近似版式预览" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock x:Name="BookNameText" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <ListBox x:Name="ItemsList" ItemsSource="{Binding Items}" DisplayMemberPath="Title" BorderThickness="0" Padding="5" SelectionChanged="ItemsList_SelectionChanged"/>
            </Border>
        <Border Grid.Column="2" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="1">
                <WebBrowser x:Name="PreviewBrowser"/>
            </Border>
        </Grid>
        <DockPanel Grid.Row="4">
            <TextBlock Text="基于临时 EPUB 展示封面、目录、章节、CSS、页边距、插图和字体；不会覆盖正式输出，也不等同于 Kindle 真机显示。" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True" Padding="20,8"/>
        </DockPanel>
    </Grid>
</Window>
