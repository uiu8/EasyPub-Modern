<Window x:Class="EasyPub.Desktop.BookPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="整书预览 · EasyPub Modern v0.19.1" Width="1120" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F5F7FB" FontFamily="Microsoft YaHei UI">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <Border DockPanel.Dock="Right" Background="#ECFDF3" BorderBrush="#A7E3C1" BorderThickness="1" CornerRadius="13" Padding="10,5"><TextBlock Text="真实 EPUB 排版" Foreground="#067647" FontWeight="SemiBold"/></Border>
            <StackPanel>
                <TextBlock Text="整书预览" FontSize="23" FontWeight="SemiBold" Foreground="#172033"/>
                <TextBlock x:Name="BookNameText" Margin="0,4,0,0" Foreground="#667085"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10">
                <ListBox x:Name="ItemsList" ItemsSource="{Binding Items}" DisplayMemberPath="Title" BorderThickness="0" Padding="5" SelectionChanged="ItemsList_SelectionChanged"/>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="1">
                <WebBrowser x:Name="PreviewBrowser"/>
            </Border>
        </Grid>
        <DockPanel Grid.Row="4">
            <TextBlock Text="封面、目录、章节、CSS、页边距、插图和嵌入字体均来自本次临时生成的 EPUB；不会覆盖正式输出。" Foreground="#667085" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True" Padding="20,8"/>
        </DockPanel>
    </Grid>
</Window>
