<Window x:Class="EasyPub.Desktop.BatchMetadataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量元数据 · EasyPub Modern v1.1.4" Width="1160" Height="620" MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" FontFamily="Microsoft YaHei UI">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="逐书填写书籍信息" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="这里会显示文件夹映射结果；保存后按逐书手动值处理，不再随规则变化。" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
        <Border Grid.Row="2" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
            <DockPanel>
                <Button Content="应用到全部" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,7" Click="ApplyAuthorToAll_Click"/>
                <TextBlock Text="批量作者" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <TextBox x:Name="BatchAuthorText" MinWidth="260" Padding="8,6"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="4" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <DataGrid x:Name="MetadataGrid" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TXT 文件" Binding="{Binding FileName}" IsReadOnly="True" Width="190"/>
                    <DataGridTextColumn Header="电子书标题" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="作者" Binding="{Binding Author, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                    <DataGridTextColumn Header="出版社" Binding="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                    <DataGridTextColumn Header="类别" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <DataGridTextColumn Header="语言" Binding="{Binding Language, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <DataGridTextColumn Header="来源" Binding="{Binding MetadataSource}" IsReadOnly="True" Width="110"/>
                    <DataGridTextColumn Header="封面" Binding="{Binding CoverState}" IsReadOnly="True" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Padding="18,8" Margin="0,0,8,0" Click="Cancel_Click"/>
        <Button Content="保存元数据" Padding="20,8" Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}" BorderBrush="{DynamicResource PrimaryActionBrush}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
